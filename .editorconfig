# .editorconfig（2026-09-03・キューA-10／出典 20260817_開発速度の根本修正 優先6）
# ⚠ これは**エンコーディングの固定**が主目的。docs 100件が黙って化けた実害（PYTHONUTF8 なしの Python）と同型の事故を、
#   エディタ・IDE・生成ツールの側でも起こさないための一次データ。★スタイル規則は最小限（既存コードを書き換えさせない）。
root = true

[*]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = false

[*.{cs,axaml,xaml}]
indent_size = 4

[*.{json,js,yml,yaml}]
indent_size = 2
charset = utf-8-bom

[*.md]
indent_size = 2
charset = utf-8-bom
trim_trailing_whitespace = false

[*.sh]
end_of_line = lf
charset = utf-8
indent_size = 2
