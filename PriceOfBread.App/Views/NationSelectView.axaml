<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PriceOfBread.App.ViewModels"
             xmlns:ctl="using:PriceOfBread.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
             x:Class="PriceOfBread.App.Views.NationSelectView"
             x:DataType="vm:NationSelectViewModel">
    <UserControl.Styles>
        <!-- 国選択ボタン：暗い背景画の上でも読めるよう不透明なパーチメント地＋濃色文字（既定Fluentボタンは半透明で沈む） -->
        <Style Selector="Button.nation">
            <Setter Property="Background" Value="{StaticResource TraceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.nation /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource TraceBrush}"/>
        </Style>
        <Style Selector="Button.nation:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource TraceBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{StaticResource InkBrush}"/>
        </Style>
        <Style Selector="Button.nation:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PressBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{StaticResource InkBrush}"/>
        </Style>
        <!-- おすすめカード：見出し（左＝国名（強さ）・右端＝難易度の色文字）＋説明（歴史的背景＋プレイフィール） -->
        <!-- ★2026-09-23：VerticalContentAlignment を Top から Stretch へ。中身を Grid(Auto,*) にしたので、
             Top のままだと ContentPresenter が中身に desired 高さしか渡さず `*` の行が潰れる（本文の高さ制約が効かない）。 -->
        <Style Selector="Button.card">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="Button.card TextBlock.cardTitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>
        <Style Selector="Button.card TextBlock.cardBody">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="12.5"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <!-- 作者指示2026-08-16「テキスト欄が足りていない」：行の途中でぶつ切りにしない＝行境界で終わらせる。
                 ★2026-09-23：**MaxLines="9" を撤去し、本文を Grid の `*` 行に置いて「残りの高さそのもの」を制約にした**。
                 9 は「165−Padding12−枠2−見出し19−本文Margin3＝129 ≧ 9行×13.5＝121.5」という手計算だった。
                 実写（清のカード・980×660）で画素を測ると 見出しのインク y230-243／本文9行が 13.5px 間隔で y251..368／
                 カード下枠 y383 ＝ 内容の下端は 383−枠1−Padding6＝376、10行目の行箱は 371.5..385 で**入らない**
                 ＝**手計算の9行は合っていた**（前の回の報告「最終行の下に約22px＝1.5行分の空き」は誤り。実測の余りは 4.5px）。
                 それでも数を置かないのは、カードの寸法を触ったときに行数の再計算が要らなくなるから＝マジックナンバーを1つ減らす。
                 撤去後も出るのは同じ9行（画像で確認・10行目のインクは1画素も無い＝高さの制約が効いている証拠）。
             ⚠**TextTrimming は効かない**。この Setter は初回コミットから在るが、省略記号は**一度も出ていない**
                 （MaxLines 時代の実写＝前の回・高さ制約にした今回の実写＝どちらも「…」無し）。Avalonia 12 は
                 **横にあふれた行**だけを省略記号へ畳むので、TextWrapping="Wrap" では畳む対象の行が原理的に生まれない。
                 消さずに残すのは、折返しをやめた時に効くのと、既定値（None）へ戻す意味が無いため。
                 本当に「続きがある」を出すなら、**本文を9行に収まる長さへ短くする**（SimCore の NationBrief.Description）か
                 カードを高くするかの二択＝この画面の XAML では作れない。 -->
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Styles>
    <Panel>
        <Image Source="avares://PriceOfBread.App/Assets/moonlit.jpg" Stretch="UniformToFill"/>
        <Border Background="#66000000"/>
        <DockPanel Margin="20,10">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <CheckBox DockPanel.Dock="Right" Name="SpectateCheck" Content="観戦" IsChecked="{Binding Spectate, Mode=TwoWay}" Foreground="{StaticResource OnImageBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="国家選択" FontSize="22" FontWeight="Bold" Foreground="{StaticResource OnImageBrush}"/>
            </DockPanel>

            <!-- おすすめ＝均等なカードを並べるだけ（作者指示2026-08-11）。★難易度はカードの見出しに書いてあるので
                 難易度で列を分けない＝2/4/1の列は高さが揃わず、形が崩れていた。枡を固定（ItemWidth/ItemHeight）＝
                 文章の長さが違っても段が揃う。並び順は易しい順（難易度の勾配は並びで伝わる）。
                 ★2026-11-12（字体を Noto Sans JP へ替えた直し）：仮名が 1 字 1.000em の全角になり 1 行の字数が 2 割減って説明文が 11 行になった＝カードの高さを 172/165→188/181（本文の領域 145 ≧ 11 行×12.5＝137.5）・
             その他の国の札は幅 150 のまま、長い名（「サルデーニャ＝ピエモンテ」）だけ Viewbox で縮めて切らない（幅を伸ばすと 1 つ余って 10 段になり、枠から溢れた）。総和＝33＋2×188＋4＋9段225 ≒ 638。
             ★カードの高さは188/181→152/145（全カ国1画面・2026-08-15）→172/165（作者指示2026-08-16「テキスト欄が
                 足りていない」＝その他の下の遊休余白から+20pxずつ回収）。寸法の総和＝見出し33＋カード2段344＋余白4＋
                 その他6列8段200 ≒ 581 ≦ 実効高約609＝スクロールバーは出ない（出現→列減→溢れの自己増殖は起きない）。 -->
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Recommended}" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="235" ItemHeight="188"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NationChoice">
                        <Button Classes="nation card" Command="{Binding ChooseCommand}" Width="227" Height="181">
                            <!-- ★2026-09-23：StackPanel から Grid(Auto,*) へ。StackPanel は子を**高さ無限**で測るので、
                                 本文の TextBlock には高さの制約が一切届かず、行数は MaxLines の手計算だけが決めていた。
                                 `*` 行なら本文に「残りの高さ」が渡る＝入らない行が落ちる＝寸法が変われば行数も追随する。 -->
                            <Grid RowDefinitions="Auto,*">
                                <!-- 見出し＝国名（強さ）を左・難易度を右端へ（作者指示2026-08-15）。難易度は3値の色分け（VM側のブラシ） -->
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Image Source="{Binding Flag}" Height="14" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Classes="cardTitle" Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Classes="cardTitle" Text="{Binding Difficulty}"
                                               Foreground="{Binding DifficultyBrush}" Margin="4,0,0,0" VerticalAlignment="Top"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Classes="cardBody" ctl:LatinText.Text="{Binding Description}"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- その他の国＝常時表示・画面幅いっぱい（作者指示2026-08-11）。名前が枠に入らない国だけ末尾を省略し、強さは必ず出す。
                 ★全カ国1画面（作者指示2026-08-15）：旧はスクロールバーが出ると幅923→5列×10段（250px）へ自己増殖する薄氷だった。
                 おすすめカードを縮めてこの枠に250px超を確保＝6列（8段200px）はもちろん、万一5列へ落ちても収まる
                 ＝寸法がスクロールバーの出現に依存しない。ScrollViewer は保険として残す。 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Others}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="156" ItemHeight="25"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NationChoice">
                            <Button Classes="nation" Command="{Binding ChooseCommand}"
                                    Width="150" Height="22" HorizontalContentAlignment="Stretch" Padding="6,0">
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                    <Image Source="{Binding Flag}" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">   <!-- 長い名は枠に合わせて縮める（切らない） -->
                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontTiny}" Foreground="{StaticResource InkBrush}"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="2" Text="{Binding StrengthLabel}" FontSize="{StaticResource FontTiny}" Foreground="{StaticResource GrayBrush}"
                                               VerticalAlignment="Center" Margin="3,0,0,0"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Panel>
</UserControl>
