<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PriceOfBread.App.ViewModels"
             x:Class="PriceOfBread.App.Views.Tabs.LawTab"
             x:DataType="vm:GameViewModel">
    <!-- Views/Tabs/LawTab.axaml ＝ 法律タブの本体。 -->
    <!-- ============ 法律（Wキー・2026-08-01に政治から分離）：法が22本に増え右列に収まらなくなった ============ -->
    <!-- 2分割：左＝法の一覧／右＝制度（自動施行の3機構の状態）＋国有化（作者指示2026-08-15で生産タブから移動）。
         巨大建造物は生産タブの下端の帯（作者指示2026-08-10のまま）。 -->
    <StackPanel Spacing="6">
<Grid ColumnDefinitions="*,14,*">
<StackPanel Grid.Column="0" Spacing="4">
<TextBlock Text="法律" Classes="section"/>
<!-- 段階ボタン横並び（1934拡張E8）：現行は濃塗り・目標は金枠・改正可能なら右に金字（政治資本コスト）・不可は理由。データ駆動（Laws）。 -->
<ItemsControl ItemsSource="{Binding Laws}">
<ItemsControl.ItemTemplate>
<DataTemplate>
<StackPanel IsVisible="{Binding Visible}">
<!-- 群見出し（2026-08-13・A案）：並びは変えず見出しを挟むだけ。★2026-08-15(7)：群の間に区切り線を追加 -->
<StackPanel IsVisible="{Binding HasGroupHeader}">
    <Border Height="1" Background="{StaticResource SandBrush}" Margin="0,6,0,2"/>
    <TextBlock Text="{Binding GroupHeader}" Foreground="{StaticResource BronzeBrush}" FontWeight="Bold" FontSize="{StaticResource FontSmall}" Margin="0,0,0,1"/>
</StackPanel>
<Grid ColumnDefinitions="84,*" Margin="0,2">
<TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}" VerticalAlignment="Center" TextWrapping="Wrap"/>
<StackPanel Grid.Column="1" Spacing="1">
    <!-- 段階ボタンは WrapPanel で幅を超えたら折返す（画面外はみ出し防止）。制定不可（前提未達）は IsEnabled=false でグレーアウト。 -->
    <ItemsControl ItemsSource="{Binding Stages}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <!-- Borderがホバーを受ける＝押せない（IsEnabled=false）段でもツールチップ（必要な政治資本）が出る -->
                <Border Background="Transparent" Margin="0,0,3,2" ToolTip.Tip="{Binding Hint}" ToolTip.ShowDelay="200">
                    <Button Classes="lawstage" Classes.current="{Binding IsCurrent}" Classes.target="{Binding IsTarget}"
                            IsEnabled="{Binding Enabled}"
                            Content="{Binding Label}" Command="{Binding Row.SelectCommand}" CommandParameter="{Binding Index}"/>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding Detail}" Classes="range" Classes.amend="{Binding Amendable}" TextWrapping="Wrap"
               IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
</StackPanel>
</Grid>
</StackPanel>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
<!-- ★2026-08-02：「議会立法」ブロックを撤去（3法の開放）。穀物法・土地改革・農奴解放は上の法律一覧で
プレイヤーも動かせるようになったので、同じ情報を2箇所に出さない。年金は社会保障の法から導出される値なので行を持たない。 -->
</StackPanel>
<!-- ★制度（2026-08-10 新設／2026-08-11に作者指示で法律と同じ形へ）：特許制度・株式会社・鉄道は
条件を満たせばAI/プレイヤーを問わず自動で施行される＝**押せない段ボタン**で状態だけを出す。
解禁条件の数値は出さない（プレイヤーが直接動かせる量ではない）。 -->
<StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="制度" Classes="section"/>
<ItemsControl ItemsSource="{Binding Institutions}">
<ItemsControl.ItemTemplate>
<DataTemplate>
<Grid ColumnDefinitions="84,*" Margin="0,2">
<TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"/>
<!-- ★2026-08-15作者フィードバック(8)：プレイヤーが押せないボタン（全グレー）はテキストへ＝現況だけを出す -->
<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
<TextBlock Text="施行" IsVisible="{Binding Enacted}" Foreground="{StaticResource GreenBrush}" FontSize="{StaticResource FontBody}" FontWeight="Bold" VerticalAlignment="Center"/>
<TextBlock Text="未施行" IsVisible="{Binding NotEnacted}" Foreground="{StaticResource InkFaintBrush}" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"/>
</StackPanel>
</Grid>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
<!-- ★国有化（作者指示2026-08-15＝生産タブ右下から移動）：法律と同じ段ボタン形。データ駆動（NationalizationLaws）。 -->
<StackPanel IsVisible="{Binding NationalizationVisible}" Spacing="4">
<Border Height="1" Background="{StaticResource SandBrush}" Margin="0,8,0,2"/>
<TextBlock Text="国有化" Classes="section"/>
<ItemsControl ItemsSource="{Binding NationalizationLaws}">
<ItemsControl.ItemTemplate>
<DataTemplate>
<Grid ColumnDefinitions="98,*" Margin="0,2" IsVisible="{Binding Visible}">
<TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}" VerticalAlignment="Center" TextWrapping="Wrap"/>
<StackPanel Grid.Column="1" Spacing="1">
    <ItemsControl ItemsSource="{Binding Stages}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Background="Transparent" Margin="0,0,3,2" ToolTip.Tip="{Binding Hint}" ToolTip.ShowDelay="200">
                    <Button Classes="lawstage" Classes.current="{Binding IsCurrent}" Classes.target="{Binding IsTarget}"
                            IsEnabled="{Binding Enabled}"
                            Content="{Binding Label}" Command="{Binding Row.SelectCommand}" CommandParameter="{Binding Index}"/>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding Detail}" Classes="range" Classes.amend="{Binding Amendable}" TextWrapping="Wrap"
               IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
</StackPanel>
</Grid>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</StackPanel>
</StackPanel>
</Grid>
    </StackPanel>
</UserControl>
