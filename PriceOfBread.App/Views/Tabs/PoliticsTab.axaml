<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PriceOfBread.App.ViewModels"
             x:Class="PriceOfBread.App.Views.Tabs.PoliticsTab"
             x:DataType="vm:GameViewModel">
    <!-- Views/Tabs/PoliticsTab.axaml ＝ 政治タブの本体。 -->
    <!-- ============ 政治（Sキー）：王権と議会・権力の取り分（半円グラフ）・政体・実績・影響力・奪い合い・議会 ============ -->
    <!-- ★2026-08-22 全面再構成（作者指示）：①半円グラフ（2026-09-07 半円化）を導入 ②支持基盤をカラム式へ ③スクロールが出ないよう上部を2段組へ。
         左列＝王権と議会・権力の取り分・政体／右列＝政治影響力・政体の実績・権力の奪い合い／下段全幅＝議会。 -->
    <StackPanel Spacing="2">
        <!-- ★2026-08-31作者指示：権力グラフを最上部・両カラム幅で大きく。2026-09-01圧縮＝器と絵を一致（大半円=箱140×72/半径68・小半円=箱60×31/半径29＝2026-09-07 半円化）＝死んだ余白を回収して無スクロール化 -->
                <!-- ★★★権力の取り分（2026-08-21作者設計・2026-08-22円グラフ化→2026-09-07半円化）：王権/議会/軍部/革命勢力の連合後シェア＝合計1。
                     予算権と統帥権は同じ正統性（王権:議会）に法の重みを掛けた導出＝独立ストックなし。⚠表示＝観測（挙動は分岐しない）。 -->
                <TextBlock Text="権力" Classes="section"/>
                <Grid ColumnDefinitions="Auto,12,220" Margin="0,2,0,0">
                    <!-- ★2026-09-07 作者指示：円→**半円**（底辺が下・左から右）。箱 幅140×高さ72＝底辺の中点(70,70)・半径68 -->
                    <Canvas Grid.Column="0" Width="140" Height="72" Background="Transparent" ToolTip.ShowDelay="200">
                        <ToolTip.Tip><TextBlock Text="{Binding ShareTip}" FontSize="{StaticResource FontSmall}"/></ToolTip.Tip>
                        <Path Data="{Binding PieCrown, Converter={x:Static vm:Conv.PathData}}" Fill="{StaticResource GoldBrush}"/>
                        <Path Data="{Binding PieParliament, Converter={x:Static vm:Conv.PathData}}" Fill="{StaticResource SteelBrush}"/>
                        <Path Data="{Binding PieArmy, Converter={x:Static vm:Conv.PathData}}" Fill="{StaticResource InkDimBrush}"/>
                        <Path Data="{Binding PieRevolution, Converter={x:Static vm:Conv.PathData}}" Fill="{StaticResource RustBrush}"/>
                    </Canvas>
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="12,4,*,Auto">
                            <Rectangle Width="10" Height="10" Fill="{StaticResource GoldBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="王権" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontSmall}"/>
                            <TextBlock Grid.Column="3" Text="{Binding ShareCrown, StringFormat=P0}" Classes="val" FontSize="{StaticResource FontSmall}"/>
                        </Grid>
                        <Grid ColumnDefinitions="12,4,*,Auto">
                            <Rectangle Width="10" Height="10" Fill="{StaticResource SteelBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="議会" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontSmall}"/>
                            <TextBlock Grid.Column="3" Text="{Binding ShareParliament, StringFormat=P0}" Classes="val" FontSize="{StaticResource FontSmall}"/>
                        </Grid>
                        <Grid ColumnDefinitions="12,4,*,Auto">
                            <Rectangle Width="10" Height="10" Fill="{StaticResource InkDimBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="軍部" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontSmall}"/>
                            <TextBlock Grid.Column="3" Text="{Binding ShareArmy, StringFormat=P0}" Classes="val" FontSize="{StaticResource FontSmall}"/>
                        </Grid>
                        <Grid ColumnDefinitions="12,4,*,Auto">
                            <Rectangle Width="10" Height="10" Fill="{StaticResource RustBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="革命勢力" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontSmall}"/>
                            <TextBlock Grid.Column="3" Text="{Binding ShareRevolution, StringFormat=P0}" Classes="val" FontSize="{StaticResource FontSmall}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
                <!-- ★2026-08-24作者指示：正統性・予算権・統帥権は**小さな半円グラフ3つ**（上の大きな半円と同じ色の文法＝王権#8A6A2A・議会#3A5A8A・軍部#7A6A55）。
                     半円の下は 見出し／優勢な側とその割合／（予算権と統帥権のみ）今の法。内訳の実数はホバー。 -->
                <Grid ColumnDefinitions="*,*,*" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="1" Background="Transparent" ToolTip.ShowDelay="200">
                        <ToolTip.Tip><TextBlock Text="{Binding LegitTip}" FontSize="{StaticResource FontSmall}"/></ToolTip.Tip>
                        <Canvas Width="60" Height="31" HorizontalAlignment="Center">
                            <Path Data="{Binding LegitPieCrown, Converter={x:Static vm:Conv.PathData}}" Fill="{StaticResource GoldBrush}"/>
                            <Path Data="{Binding LegitPieParliament, Converter={x:Static vm:Conv.PathData}}" Fill="{StaticResource SteelBrush}"/>
                            <Path Data="{Binding LegitPieArmy, Converter={x:Static vm:Conv.PathData}}" Fill="{StaticResource InkDimBrush}"/>
                        </Canvas>
                        <TextBlock Text="正統性" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontSmall}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LegitTopText}" Classes="val" FontSize="{StaticResource FontSmall}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="1" Background="Transparent" ToolTip.ShowDelay="200">
                        <ToolTip.Tip><TextBlock Text="{Binding BudgetTip}" FontSize="{StaticResource FontSmall}"/></ToolTip.Tip>
                        <Canvas Width="60" Height="31" HorizontalAlignment="Center">
                            <Path Data="{Binding BudgetPieCrown, Converter={x:Static vm:Conv.PathData}}" Fill="{StaticResource GoldBrush}"/>
                            <Path Data="{Binding BudgetPieParliament, Converter={x:Static vm:Conv.PathData}}" Fill="{StaticResource SteelBrush}"/>
                            <Path Data="{Binding BudgetPieArmy, Converter={x:Static vm:Conv.PathData}}" Fill="{StaticResource InkDimBrush}"/>
                        </Canvas>
                        <TextBlock Text="予算権" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontSmall}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding BudgetTopText}" Classes="val" FontSize="{StaticResource FontSmall}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding BudgetLawName}" Foreground="{StaticResource InkFaintBrush}" FontSize="{StaticResource FontTiny}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="1" Background="Transparent" ToolTip.ShowDelay="200">
                        <ToolTip.Tip><TextBlock Text="{Binding CommandTip}" FontSize="{StaticResource FontSmall}"/></ToolTip.Tip>
                        <Canvas Width="60" Height="31" HorizontalAlignment="Center">
                            <Path Data="{Binding CommandPieCrown, Converter={x:Static vm:Conv.PathData}}" Fill="{StaticResource GoldBrush}"/>
                            <Path Data="{Binding CommandPieParliament, Converter={x:Static vm:Conv.PathData}}" Fill="{StaticResource SteelBrush}"/>
                            <Path Data="{Binding CommandPieArmy, Converter={x:Static vm:Conv.PathData}}" Fill="{StaticResource InkDimBrush}"/>
                        </Canvas>
                        <TextBlock Text="統帥権" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontSmall}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CommandTopText}" Classes="val" FontSize="{StaticResource FontSmall}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CommandLawName}" Foreground="{StaticResource InkFaintBrush}" FontSize="{StaticResource FontTiny}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="軍が指揮権を独占" Foreground="{StaticResource RustBrush}" FontWeight="Bold" FontSize="{StaticResource FontBody}" Margin="0,2,0,0"
                           IsVisible="{Binding ArmyHoldsCommand}"/>
        <Border Height="1" Background="{StaticResource SandBrush}" Margin="0,3,0,3"/>
        <Grid ColumnDefinitions="*,16,*">
            <!-- ================= 左列 ================= -->
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="王権と議会" Classes="section"/>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="政体" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding PolityText}" Classes="val" VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="王冠の形" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding CrownText}" Classes="val" VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2" Background="Transparent" ToolTip.ShowDelay="200">
                    <ToolTip.Tip>
                        <TextBlock Text="{Binding PolityAttractorTip}" FontSize="{StaticResource FontSmall}"/>
                    </ToolTip.Tip>
                    <TextBlock Text="望まれている政体" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding PolityAttractorText}" Classes="val" VerticalAlignment="Center"/>
                </Grid>
                <!-- ★2026-08-17：「議会健全性」→「議会統制力」（エンジンと同名）。ホバー＝ラベルが動く床。 -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,2" Background="Transparent" ToolTip.ShowDelay="200">
                    <ToolTip.Tip>
                        <TextBlock Text="{Binding ParliamentControlTip}" FontSize="{StaticResource FontSmall}"/>
                    </ToolTip.Tip>
                    <TextBlock Text="議会統制力" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ParliamentControlText}" Classes="val" VerticalAlignment="Center"/>
                </Grid>
                <!-- ★政治資本（作者裁定N2・2026-09-21）：現在／最大。物差しは法律タブの代価（×100）と同じ。2026-09-21 ㉖で常設。 -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,2" Background="Transparent" ToolTip.ShowDelay="200">
                    <ToolTip.Tip>
                        <TextBlock Text="{Binding PoliticalCapitalTip}" FontSize="{StaticResource FontSmall}"/>
                    </ToolTip.Tip>
                    <TextBlock Text="政治資本" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding PoliticalCapitalText}" Classes="val" VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="王権と議会の協力度" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding CoopParliamentText}" Classes="val" VerticalAlignment="Center"/>
                </Grid>
                <!-- ★2026-08-24作者指示：政変圧力を戦争タブからここへ（政体が動くかの量＝王権と議会の隣で読む）。
                     政変圧力＝(改革派+急進派)÷治安維持力（Politics.Transition と同一式）・100%超で警告色。 -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,2" Background="Transparent" ToolTip.ShowDelay="200">
                    <ToolTip.Tip>
                        <TextBlock Text="{Binding ChallengeTip}" FontSize="{StaticResource FontSmall}"/>
                    </ToolTip.Tip>
                    <TextBlock Text="政変圧力" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ChallengeText}" Foreground="{Binding ChallengeBrush}" Classes="val" VerticalAlignment="Center"/>
                </Grid>


                <!-- 政体パネル（政体フレーバー レバー4・2026-07-24）：現政体で効いている量のデータ行 -->
                <Border Height="1" Background="{StaticResource SandBrush}" Margin="0,3,0,3"/>
                <TextBlock Text="政体" Classes="section"/>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="経済政策の決定" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding PolityEconControlText}" Classes="val" VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="国債の信認割引" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding PolityBondDiscountText}" Classes="val" VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="参政権と報道の剥奪" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding PolityRollbackText}" Classes="val" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- ================= 右列 ================= -->
            <StackPanel Grid.Column="2" Spacing="2">
                <TextBlock Text="政治影響力" Classes="section"/>
                <ItemsControl ItemsSource="{Binding Blocs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip.Tip="{Binding Tip}" ToolTip.ShowDelay="200" Background="Transparent" ColumnDefinitions="*,Auto" Margin="0,2">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource InkBrush}" FontSize="{StaticResource FontBody}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Percent}" Foreground="{StaticResource BronzeBrush}" FontSize="{StaticResource FontBody}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ★政体の実績は下段（政体の実績｜議会の支持の50/50）へ移設（作者裁定2026-08-24） -->

                <!-- ★権力の奪い合い（2026-08-17）：議会統制力を今期動かした経路＝寄与の大きい順。判定は HasPowerStruggle（議会の成立を待たない）。 -->
                <StackPanel Spacing="2" IsVisible="{Binding HasPowerStruggle}">
                    <Border Height="1" Background="{StaticResource SandBrush}" Margin="0,3,0,3"/>
                    <TextBlock Text="権力の奪い合い" Classes="section"/>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2" Background="Transparent" ToolTip.ShowDelay="200">
                        <ToolTip.Tip>
                            <TextBlock Text="{Binding PcDeltaTip}" FontSize="{StaticResource FontSmall}"/>
                        </ToolTip.Tip>
                        <TextBlock Text="議会統制力の今期の変化" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}"/>
                        <TextBlock Grid.Column="1" Text="{Binding PcDeltaText}" Foreground="{Binding PcDeltaBrush}" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2" Background="Transparent" ToolTip.ShowDelay="200">
                        <ToolTip.Tip>
                            <TextBlock Text="{Binding ArmyLoyaltyTip}" FontSize="{StaticResource FontSmall}"/>
                        </ToolTip.Tip>
                        <TextBlock Text="軍の忠誠" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ArmyLoyaltyText}" Classes="val" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2" Background="Transparent" ToolTip.ShowDelay="200">
                        <ToolTip.Tip>
                            <TextBlock Text="{Binding ArmyPowerTip}" FontSize="{StaticResource FontSmall}"/>
                        </ToolTip.Tip>
                        <TextBlock Text="軍の政治力" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ArmyPowerText}" Classes="val" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- 経路の内訳（寄与の大きい順・緑＝議会が得る／赤＝王権と軍が取り返す）。動いていない経路は行を出さない -->
                    <ItemsControl ItemsSource="{Binding PowerShifts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PowerShiftRow">
                                <Grid ColumnDefinitions="*,Auto" Margin="12,1,0,1" Background="Transparent" ToolTip.ShowDelay="200">
                                    <ToolTip.Tip>
                                        <TextBlock Text="{Binding Tip}" FontSize="{StaticResource FontSmall}"/>
                                    </ToolTip.Tip>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource InkBrush}" FontSize="{StaticResource FontBody}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{Binding Brush}" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ★下段＝政体の実績｜議会の支持を**各50%**で横並び（作者裁定2026-08-24）。上段の2列と同じ列幅（各298px）＝縦の線が通る。
             左は政体があれば常に出る（議会の無い国では右半分だけが消える）。 -->
        <Border Height="1" Background="{StaticResource SandBrush}" Margin="0,3,0,3"/>
        <Grid ColumnDefinitions="*,16,*">
        <!-- 政体別実績ストック（信認⇔失望）：4系統の固着⇔カオスのドライバ。緑＝信認・赤＝失望のバー。 -->
        <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="政体の実績" Classes="section"/>
            <ItemsControl ItemsSource="{Binding RegimeRecords}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RegimeRow">
                        <Grid ColumnDefinitions="72,*,Auto" Margin="0,2">
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource InkBrush}" FontSize="{StaticResource FontBody}"/>
                            <Border Grid.Column="1" Width="130" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#E4DABE" CornerRadius="2">
                                <Border Height="10" Width="{Binding BarWidth}" HorizontalAlignment="Left" Background="{Binding Brush}" CornerRadius="2"/>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{Binding Brush}" FontSize="{StaticResource FontSmall}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <!-- ★議会の支持（2026-08-04・作者指摘「議会の存在感が薄い」／2026-08-24に名称と位置を変更）：議席バー・得票率・次の総選挙・支持基盤。 -->
        <StackPanel Grid.Column="2" Spacing="3" IsVisible="{Binding HasParliament}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="議会の支持" Classes="section"/>
                <TextBlock Grid.Column="1" Text="{Binding NextElectionText}" Classes="val" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="{Binding ParliamentText}" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap"/>
            <!-- 議席（確定＝選挙時のスナップショット）と得票（毎期の世論）は別物＝並ぶ2つの数字に見出しを付ける。 -->
            <Grid ColumnDefinitions="64,*,52,52" Margin="0,2,0,0">
                <TextBlock Grid.Column="2" Text="議席" Classes="section" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="得票" Classes="section" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding SeatRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SeatRow">
                        <Grid ColumnDefinitions="64,*,52,52" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="{StaticResource FontBody}" Foreground="{StaticResource InkBrush}"
                                       FontWeight="{Binding IsGov, Converter={x:Static vm:Conv.BoolToWeight}}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#E6DEC8" Height="14" VerticalAlignment="Center" CornerRadius="2">
                                <Border Background="{Binding Brush}" HorizontalAlignment="Left" CornerRadius="2"
                                        Width="{Binding SeatFrac, Converter={x:Static vm:Conv.FracToWidth}}"/>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding Seats}" FontSize="{StaticResource FontBody}" Foreground="{StaticResource InkBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding Votes}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource InkFaintBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- ★支持基盤＝カラム式（作者指示2026-08-22）：旧「保守29%/自由48%/社会23%」の連結文字列をやめ、見出しつきの列へ。 -->
            <Grid ColumnDefinitions="*,52,56,56,56" Margin="0,6,0,0">
                <TextBlock Grid.Column="0" Text="支持基盤" Classes="section"/>
                <TextBlock Grid.Column="1" Text="割合" Classes="section" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="保守" Classes="section" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="自由" Classes="section" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="社会" Classes="section" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding SupportRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SupportRow">
                        <Grid ColumnDefinitions="*,52,56,56,56" Margin="0,1">
                            <TextBlock Grid.Column="0" Text="{Binding Class}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Share}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource BronzeBrush}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="{Binding Cons}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource InkMutedBrush}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="{Binding Lib}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource InkMutedBrush}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="{Binding Soc}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource InkMutedBrush}" TextAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="dialog" Content="議会を解散(総選挙)" Command="{Binding DissolveParliamentCommand}"
                    IsVisible="{Binding CanDissolveParliament}" Margin="0,6,0,0"
                    ToolTip.Tip="{Binding DissolveParliamentTip}"/>
        </StackPanel>
        </Grid>

    </StackPanel>
</UserControl>
