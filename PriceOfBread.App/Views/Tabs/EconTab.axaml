<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PriceOfBread.App.ViewModels"
             x:Class="PriceOfBread.App.Views.Tabs.EconTab"
             x:DataType="vm:GameViewModel">
    <!-- Views/Tabs/EconTab.axaml ＝ 財政（経済）タブの本体。 -->
    <UserControl.Resources>
        <!-- ★財政の段（作者裁定2026-09-12 R1/R2）＝税・支出・軍事費の段ボタン1行。法律タブ／通貨制度の段ボタンと同じ見た目・同じ規則
             （現行=濃塗り／目標=金枠／押せない段=薄く＝App.axaml の Button.lawstage:disabled）。
             項目名は真上の行（所得税 ○%　実効 ○%）が既に名乗るのでここには置かない。
             ★2026-09-20（段の点火）：税・支出のスライダーは廃止＝段ボタンへ一本化。
             ★2026-09-23（作者裁定）：残る4本（行政費・近代化投資・関税・政策金利）も5段ボタンへ＝**このタブにスライダーは1本も無い**。
             陸海の比のレバーは廃止（地理が決める）。社会保障の法の段は法律タブからここへ移設。 -->
        <DataTemplate x:Key="FiscalStageRow" x:DataType="vm:LawRowVM">
            <StackPanel Spacing="1" Margin="0,0,0,2">
                <ItemsControl ItemsSource="{Binding Stages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LawStageVM">
                            <Border Background="Transparent" Margin="0,0,3,2" ToolTip.Tip="{Binding Hint}" ToolTip.ShowDelay="200">
                                <Button Classes="lawstage" Classes.current="{Binding IsCurrent}" Classes.target="{Binding IsTarget}"
                                        IsEnabled="{Binding Enabled}"
                                        Content="{Binding Label}" Command="{Binding Row.SelectCommand}" CommandParameter="{Binding Index}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Detail}" Classes="range" Classes.amend="{Binding Amendable}" TextWrapping="Wrap"
                           IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <!-- ============ 経済 ============ -->
    <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,14,*">
            <!-- 支出（左）：レバー→固定費→合計 -->
            <!-- ★合計の高さ揃え（作者フィードバック2026-08-10）：支出と収入は行数が違うので合計行の縦位置がずれていた。
                 両列とも「項目（上詰め・Auto）／余白（*）／合計（下詰め・Auto）」の3行にして、合計を列の下端へ固定する。
                 外側の Grid が2列を同じ高さへ伸ばす＝**短い側の余白が伸びる**だけなので、どちらの行が増減しても横並びは崩れない。 -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
            <StackPanel Grid.Row="0" Spacing="4">
                <Grid ColumnDefinitions="*,60,64">
                    <TextBlock Grid.Column="0" Text="支出" Classes="section"/>
                    <TextBlock Grid.Column="1" Text="予測" Classes="range" TextAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="実効" Classes="range" TextAlignment="Right"/>
                </Grid>
                <!-- ★陸海の維持費（2026-08-04・作者仕様(5)／2026-08-11に金額を陸海で分離）。
                     軍事費の集約行は廃止＝同じ金を「軍事費」と「陸軍＋海軍」の2通りで見せる二重表示だった。
                     熟練は財政の量ではないのでこのタブから撤去（作者指示2026-08-11）。 -->
                <Grid ColumnDefinitions="*,60,64">
                    <TextBlock Grid.Column="0" Text="{Binding ArmyUpkeepLine}" Classes="lever"/>
                    <TextBlock Grid.Column="1" Text="{Binding ArmyAmt}" Classes="dim" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding ArmyAct}" Classes="lever" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
                <Grid ColumnDefinitions="*,60,64">
                    <TextBlock Grid.Column="0" Text="{Binding NavyUpkeepLine}" Classes="lever"/>
                    <TextBlock Grid.Column="1" Text="{Binding NavyAmt}" Classes="dim" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding NavyAct}" Classes="lever" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
                <!-- ★軍事費の段（R2「低/中/高/戦時の4段。戦時経済は総動員とセットで、戦後は下の値に戻る」）。
                     ★M2（2026-09-19）：総動員は戦時段を解禁するだけ＝段は選ぶ（押し上げない）。解禁の外では段3で止まる。
                     段は**合計**にだけ掛かる（D4）＝上の2行は、地理が決めた比で合計が陸海へ割れた結果を名乗る。
                     ⚠合計の金額行は置かない（同じ金を「軍事費」と「陸軍＋海軍」の2通りで見せる二重表示は2026-08-11に廃止済み）。 -->
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="軍事費" Classes="lever" VerticalAlignment="Top" Margin="0,2,8,0"/>
                    <ContentControl Grid.Column="1" Content="{Binding MilitaryLaw}" ContentTemplate="{StaticResource FiscalStageRow}"/>
                </Grid>
                <!-- ★「海軍の比率」のレバーは撤去（作者裁定2026-09-23）。2026-08-04 作者仕様(5)「陸海の割り振りは**廃止**し『陸軍維持費』『海軍維持費』とする」・
                     2026-08-10「陸軍と海軍の**注力レバーは廃止**」で一度消えたものが、2026-09-20（軍事費の段の点火＝陸海2本の金額スライダーの撤去）の
                     副作用で「比」1本として復活していた＝消し忘れではなく意図して入れ直されたもの。いまは**誰も比を振らない**＝地理が決める
                     （UtilityAgent.SetNavalUpkeepShare を AI もプレイヤーも同じ引数で通る）＝レバーが1本減り、AI・プレイヤー等価が戻る。 -->
                <Grid ColumnDefinitions="*,60,64" Background="Transparent" ToolTip.Tip="{Binding AdminTip}" ToolTip.ShowDelay="200">
                    <TextBlock Grid.Column="0" Text="{Binding AdminLine}" Classes="lever"/>
                    <TextBlock Grid.Column="1" Text="{Binding AdminAmt}" Classes="dim" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding AdminAct}" Classes="lever" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
                <!-- ★レバーの5段（作者裁定2026-09-23）＝行政費・近代化投資・関税・政策金利のスライダーを5段ボタンへ。
                     4本とも TickFrequency=0.05 の21点の離散値だった＝**粗視化だけ**でエンジンは1ビットも変わらない。
                     ⚠議会を通す「段の法」にはしない（PolicyAxis を足さない）＝行政費は行政府の内部事項・関税はR3・近代化投資はR4の裁定のまま。 -->
                <ContentControl Content="{Binding AdminSpendLever}" ContentTemplate="{StaticResource FiscalStageRow}"/>
                <Grid ColumnDefinitions="*,60,64">
                    <TextBlock Grid.Column="0" Text="{Binding EduLine}" Classes="lever"/>
                    <TextBlock Grid.Column="1" Text="{Binding EduAmt}" Classes="dim" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding EduAct}" Classes="lever" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
                <ContentControl Content="{Binding EduSpendLaw}" ContentTemplate="{StaticResource FiscalStageRow}"/>
                <!-- ★社会保障のスライダーは撤去（2026-09-12・R1の付随＝二重操作の解消）：社会保障は既に**法**（救貧法/労災/失業保険/年金）で、
                     同じ Policy.SocialSecurityTarget を法律タブの行とこのスライダーの2箇所が叩いていた（20段のつまみに見えて効果は4段）。
                     ★2026-09-23（作者裁定）：その**法の段**をここへ移した（金本位・資本移動と同じ扱い＝国庫に触る法は財政の画面で扱う）。
                     法律タブの「教育と労働」群からは外してある＝同じ法を2箇所に出さない。押せば議会を通る（法としての扱いは不変）。 -->
                <Grid ColumnDefinitions="*,60,64">
                    <TextBlock Grid.Column="0" Text="{Binding WelLine}" Classes="lever"/>
                    <TextBlock Grid.Column="1" Text="{Binding WelAmt}" Classes="dim" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding WelAct}" Classes="lever" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
                <ContentControl Content="{Binding WelfareLaw}" ContentTemplate="{StaticResource FiscalStageRow}" IsVisible="{Binding WelfareLaw.Visible}"/>
                <Grid ColumnDefinitions="*,60,64">
                    <!-- ★技術水準の年次推移をここへ（作者指示2026-08-15「技術力はヘッダーから撤去＝財政タブの技術効率へ移設」・2026-09-23に結線）。
                         この行だけが「効率 +n%」＝最先端との差を名乗る＝技術の量はこの吹き出しに集める。
                         折れ線の作りはヘッダー国庫のホバー（GameView.axaml）と同じ1本（HeaderStat＋Polyline）＝新しい部品を作らない。
                         ⚠箱は Width ではなく MinWidth＝内訳の行が見積りより長いときに無言でクリップさせない。 -->
                    <TextBlock Grid.Column="0" Text="{Binding IndLine}" Classes="lever" ToolTip.ShowDelay="200" Background="Transparent">
                        <ToolTip.Tip>
                            <StackPanel MinWidth="272" Spacing="4">
                                <TextBlock Text="{Binding IndTip}" FontSize="{StaticResource FontSmall}"/>
                                <TextBlock Text="{Binding TechHover.GraphTitle}" FontWeight="Bold" FontSize="{StaticResource FontSmall}"/>
                                <Border Background="#FBF7EC" BorderBrush="{StaticResource SandDarkBrush}" BorderThickness="1" Width="248" Height="72" HorizontalAlignment="Left" IsVisible="{Binding TechHover.HasGraph}">
                                    <Canvas Width="240" Height="64" Margin="3,3,0,0" ClipToBounds="True">
                                        <Polyline Points="{Binding TechHover.SafePoints}" Stroke="{StaticResource BlueBrush}" StrokeThickness="1.5"/>
                                    </Canvas>
                                </Border>
                                <TextBlock Text="{Binding TechHover.RangeText}" FontSize="{StaticResource FontTiny}" Foreground="{StaticResource InkMutedBrush}" IsVisible="{Binding TechHover.HasGraph}"/>
                            </StackPanel>
                        </ToolTip.Tip>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding IndAmt}" Classes="dim" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding IndAct}" Classes="lever" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
                <!-- ★近代化投資のレバーを復活（2026-08-10）。汚職根絶と違い、これは**自動化できない裁量**＝
                     「いつ・どれだけ国庫を工業化に注ぐか」は経済運営の主要な判断そのもの（AIもスタンス別に率を自分で選ぶ）。
                     ⚠エンジン側の対＝Simulation.QuarterStart がプレイヤー国（Power.IsPlayer）を自動代入から除外する。片方だけでは効かない。
                     上限は付けない＝最上段は100%（禁止ではなく「ほとんどの国で払えないほど高額」＝コストが frac→1 で発散する形で表現済み）。
                     ★2026-09-23：スライダー→5段ボタン（0%/25%/50%/75%/最大）。 -->
                <ContentControl Content="{Binding ModernizeLever}" ContentTemplate="{StaticResource FiscalStageRow}"/>
                <!-- 国民形成費レバーは廃止（2026-07-19ユーザー裁定）＝選挙を望む層が自費で国民運動を賄う（内訳はヘッダー国民意識のホバー） -->
                <Border Height="1" Background="{StaticResource SandBrush}" Margin="0,4"/>
                <!-- ★汚職根絶の行は撤去（汚職V2点火2026-08-15・8d裁定）：V2では根絶費の動詞ごと死ぬ（監視は法＝報道/資格任用/議会予算権で買う）。
                     汚職の現況はヘッダー汚職ホバー（漏れ・行政効率・監視の3因子）へ一本化。 -->
                <Grid ColumnDefinitions="*,60,64">
                    <TextBlock Grid.Column="0" Text="{Binding InterestLine}" Classes="dim"/>
                    <TextBlock Grid.Column="1" Text="{Binding InterestAmt}" Classes="dim" TextAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="{Binding InterestAct}" Classes="lever" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
                <Grid ColumnDefinitions="*,60,64">
                    <TextBlock Grid.Column="0" Text="{Binding PensionLine}" Classes="dim"/>
                    <TextBlock Grid.Column="1" Text="{Binding PensionAmt}" Classes="dim" TextAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="{Binding PensionAct}" Classes="lever" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
                <Grid ColumnDefinitions="*,60,64" IsVisible="{Binding ColonialRowVisible}">
                    <TextBlock Grid.Column="0" Text="{Binding ColonialLine}" Classes="dim"/>
                    <!-- ★2026-09-03（AUD-10）：予測列は空＝実効列と同じ数字を2回並べない（他行は Amt/Act が別プロパティ） -->
                    <TextBlock Grid.Column="2" Text="{Binding ColonialAmt}" Classes="lever" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
                <Grid ColumnDefinitions="*,60,64" IsVisible="{Binding TributeRowVisible}">
                    <TextBlock Grid.Column="0" Text="{Binding TributeLine}" Classes="dim"/>
                    <!-- ★2026-09-03（AUD-10）：予測列は空＝実効列と同じ数字を2回並べない（他行は Amt/Act が別プロパティ） -->
                    <TextBlock Grid.Column="2" Text="{Binding TributeAmt}" Classes="lever" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
                <Grid ColumnDefinitions="*,60,64">
                    <TextBlock Grid.Column="0" Text="外資流出" Classes="dim"/>
                    <!-- ★2026-09-03（AUD-10）：予測列は空＝実効列と同じ数字を2回並べない（他行は Amt/Act が別プロパティ） -->
                    <TextBlock Grid.Column="2" Text="{Binding ForeignOutAmt}" Classes="lever" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Row="2" Spacing="4">
                <Border Height="1" Background="{StaticResource SandBrush}" Margin="0,4"/>
                <Grid ColumnDefinitions="*,60,64">
                    <TextBlock Grid.Column="0" Text="合計" Foreground="{StaticResource InkMutedBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SpendTotalText}" Foreground="{StaticResource InkMutedBrush}" FontSize="{StaticResource FontSmall}" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding SpendTotalAct}" Foreground="{StaticResource InkBrush}" FontSize="{StaticResource FontBody}" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
            </StackPanel>
            </Grid>
            <!-- 収入（右） -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
            <StackPanel Grid.Row="0" Spacing="4">
                <Grid ColumnDefinitions="*,60,64">
                    <TextBlock Grid.Column="0" Text="収入" Classes="section"/>
                    <TextBlock Grid.Column="1" Text="予測" Classes="range" TextAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="実効" Classes="range" TextAlignment="Right"/>
                </Grid>
                <Grid ColumnDefinitions="*,60,64">
                    <TextBlock Grid.Column="0" Text="{Binding IncomeLine}" Classes="lever"/>
                    <TextBlock Grid.Column="1" Text="{Binding IncomeAmt}" Classes="dim" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding IncomeAct}" Classes="lever" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
                <ContentControl Content="{Binding IncomeTaxLaw}" ContentTemplate="{StaticResource FiscalStageRow}"/>
                <Grid ColumnDefinitions="*,60,64">
                    <TextBlock Grid.Column="0" Text="{Binding ProgLine}" Classes="lever"/>
                    <TextBlock Grid.Column="1" Text="{Binding ProgAmt}" Classes="dim" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding ProgAct}" Classes="lever" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
                <ContentControl Content="{Binding ProgressiveTaxLaw}" ContentTemplate="{StaticResource FiscalStageRow}"/>
                <Grid ColumnDefinitions="*,60,64">
                    <TextBlock Grid.Column="0" Text="{Binding PollLine}" Classes="lever"/>
                    <TextBlock Grid.Column="1" Text="{Binding PollAmt}" Classes="dim" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding PollAct}" Classes="lever" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
                <ContentControl Content="{Binding PollTaxLaw}" ContentTemplate="{StaticResource FiscalStageRow}"/>
                <Grid ColumnDefinitions="*,60,64">
                    <TextBlock Grid.Column="0" Text="{Binding LandLine}" Classes="lever"/>
                    <TextBlock Grid.Column="1" Text="{Binding LandAmt}" Classes="dim" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding LandAct}" Classes="lever" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
                <ContentControl Content="{Binding LandTaxLaw}" ContentTemplate="{StaticResource FiscalStageRow}"/>
                <!-- 専売に率のレバーは無い（作者裁定2026-09-20＝材を選ぶのみ）＝生産タブの財ごとの入/切だけ。ここは対象の広さ・実効率・実績の表示 -->
                <Grid ColumnDefinitions="*,60,64">
                    <TextBlock Grid.Column="0" Text="{Binding MonopolyLine}" Classes="lever"/>
                    <TextBlock Grid.Column="1" Text="{Binding MonopolyAmt}" Classes="dim" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding MonopolyAct}" Classes="lever" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
                <Grid ColumnDefinitions="*,60,64">
                    <TextBlock Grid.Column="0" Text="{Binding TariffLine}" Classes="lever"/>
                    <TextBlock Grid.Column="1" Text="{Binding TariffAmt}" Classes="dim" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding TariffAct}" Classes="lever" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
                <!-- ★2026-09-23：関税のスライダー→5段ボタン（-25%/0%/25%/50%/最大＝作者の指定）。下限＝Coef.TariffFloor（負＝ダンピング）・上限＝TariffCeil。 -->
                <ContentControl Content="{Binding TariffLever}" ContentTemplate="{StaticResource FiscalStageRow}"/>
                <Grid ColumnDefinitions="*,60,64" Background="Transparent" ToolTip.Tip="{Binding ForeignInTip}" ToolTip.ShowDelay="200">
                    <TextBlock Grid.Column="0" Text="外資流入" Classes="dim"/>
                    <!-- ★2026-09-03（AUD-10）：予測列は空＝実効列と同じ数字を2回並べない（他行は Amt/Act が別プロパティ） -->
                    <TextBlock Grid.Column="2" Text="{Binding ForeignInAmt}" Classes="lever" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
                <Grid ColumnDefinitions="*,60,64" IsVisible="{Binding TributeInRowVisible}">
                    <TextBlock Grid.Column="0" Text="属国貢納(受取)" Classes="dim"/>
                    <TextBlock Grid.Column="1" Text="{Binding TributeInAmt}" Classes="dim" TextAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="{Binding TributeInAmt}" Classes="lever" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Row="2" Spacing="4">
                <Border Height="1" Background="{StaticResource SandBrush}" Margin="0,4"/>
                <Grid ColumnDefinitions="*,60,64">
                    <TextBlock Grid.Column="0" Text="合計" Foreground="{StaticResource InkMutedBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding RevenueTotalText}" Foreground="{StaticResource InkMutedBrush}" FontSize="{StaticResource FontSmall}" TextAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding RevenueTotalAct}" Foreground="{StaticResource InkBrush}" FontSize="{StaticResource FontBody}" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
            </StackPanel>
            </Grid>
        </Grid>
        <!-- 収支＝収入・支出欄の右下に大きく表示（2026-07-19ユーザー指示）。
             ★2026-08-10：2列の外へ出した＝合計を両列の下端へ固定するため（収支が収入列に残っていると、
             収入側だけ合計の下に続きがあることになり、合計を下端に置けない）。列枠は上の2列と同一なので位置は変わらない。 -->
        <Grid ColumnDefinitions="*,14,*">
            <StackPanel Grid.Column="2" Spacing="4">
                <Border Height="1" Background="{StaticResource SandBrush}" Margin="0,4,0,4"/>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="収支" Foreground="{StaticResource BronzeBrush}" FontWeight="Bold" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding LedgerBalanceText}" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="22" TextAlignment="Right"/>
                        <TextBlock Text="{Binding BudgetBalanceText, StringFormat='予測 {0}'}" Foreground="{StaticResource InkMutedBrush}" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                        <!-- ★国庫の余裕（2026-08-04）＝AIの逼迫/潤沢と同じ物差し（月次義務の何か月分か） -->
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
        <!-- ★国庫の実績（2026-08-13・作者指示「国庫に触るものは全て財政タブに入れる」）。
             上の2列は**経常予算の予想**なので、国債の起債/償還・通貨切下げ・賠償金・通行料・国営工場・
             巨大建造物・工場建設・戦費 が1つも出ていなかった＝ヘッダーの収支と一致しなかった。
             ここはエンジンの台帳（World.TreasuryLedger＝全ての書き手を通した）の月次差分そのもので、
             合計は上の「収支」＝ヘッダーの収支と厳密に一致する。0の区分は行を出さない。 -->
        <Border Height="1" Background="{StaticResource SandBrush}" Margin="0,4,0,2"/>
        <Grid ColumnDefinitions="*,14,*">
            <StackPanel Grid.Column="0" Spacing="1">
                <TextBlock Text="国庫の支出" Classes="section"/>
                <ItemsControl ItemsSource="{Binding LedgerOut}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LedgerRow">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontSmall}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Amount}" Foreground="{StaticResource InkBrush}" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="1">
                <TextBlock Text="国庫の収入" Classes="section"/>
                <ItemsControl ItemsSource="{Binding LedgerIn}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LedgerRow">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontSmall}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Amount}" Foreground="{StaticResource InkBrush}" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- 金融・国債：収入:支出の下に配置（2026-07-20ユーザー指示・従来は第3列） -->
        <Border Height="1" Background="{StaticResource SandBrush}" Margin="0,4,0,2"/>
        <StackPanel Spacing="4">
        <TextBlock Text="金融" Classes="section"/>
        <!-- ★2026-08-02の再構成（作者指示）：**数値を上に一列でまとめ**、その下にスライダー、同じ行にスイッチ。
             ⚠「未加入」等の状態文字は出さない＝ボタン自身がスイッチで、押せば反転するので状態はボタンが語る。 -->
        <!-- ★2026-08-31作者指示：物価・為替・貸出金利は縦並び（他のデータ行と同じ1行1項目）
             ★2026-09-23（作者指示「金融が縦に長すぎる。二段組にする」）：データ行6本を**そのまま**左右2列へ振り分けた
             （中の Grid は1文字も変えていない＝値の位置・書式・ホバーは不変）。6行→3行で送りが約80px縮む。
             ⚠条件付き非表示の行（貸出金利＝LoanRateVisible・家計債務＝HouseholdLoanVisible・兌換カバー率＝CoverVisible）は**各列の最下段**に置く＝消えたときに空くのが列の末尾だけになる。
             ★2026-09-26（外部レビューの検討 項目13前）：貸出金利と家計債務は、エンジンに量が立つ係数（年率換算の2本／個人債務の主フラグ）が0のあいだは行ごと隠す（点火すれば自動で出る）。
             段間は上のブロック（収支・台帳）と同じ *,14,* に揃える。ScrollViewer は足さない（縦送りは GameView の DockScroll が持つ）。 -->
        <Grid ColumnDefinitions="*,14,*">
            <StackPanel Grid.Column="0" Spacing="4">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="物価" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding PriceLevelText}" Classes="val" VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="為替" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ExchangeRateText}" Classes="val" VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,4" IsVisible="{Binding LoanRateVisible}">
                    <TextBlock Text="貸出金利" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding LoanRateText}" Classes="val" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="損失の負債化" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding LossFinancedText}" Classes="val" VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2" IsVisible="{Binding HouseholdLoanVisible}">
                    <TextBlock Text="家計債務" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding HouseholdLoanText}" Classes="val" VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Background="Transparent" ToolTip.ShowDelay="200" IsVisible="{Binding CoverVisible}" Margin="0,0,0,4">
                    <ToolTip.Tip><TextBlock Text="{Binding CoverTip}" FontSize="{StaticResource FontSmall}"/></ToolTip.Tip>
                    <TextBlock Text="兌換カバー率" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding CoverText}" Classes="val" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Grid>
        <!-- ★2026-08-02：**2段組のレバーと幅を合わせる**（作者指示の再確認）。
             金融ブロックだけ全幅だと、税レバー（左右2列）に対して目盛の縮尺が2倍違って見えた。
             左列にレバー、右列にスイッチを置けば幅が揃い、行も詰まる。
             ★2026-09-23：上のデータ行も二段組にしたので段間を上のブロックと同じ 14 へ揃えた（*,24,* → *,14,*）。 -->
        <Grid ColumnDefinitions="*,14,*">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{Binding InterestLeverLine}" Classes="lever"/>
                <!-- ★2026-09-23：政策金利のスライダー→5段ボタン（上限＝InterestCeil＝最上段「最大」）。
                     ⚠トリレンマ（兌換維持＋資本自由）で金利が自分のものでなくなる時は**段ごと掴めなくする**＝
                     IsEnabled をこの ContentControl に置く（Avalonia は無効が子へ伝わる）＝判定式は従来どおり InterestLeverEnabled の1本。 -->
                <ContentControl Content="{Binding RateLever}" ContentTemplate="{StaticResource FiscalStageRow}" IsEnabled="{Binding InterestLeverEnabled}"/>
            </StackPanel>
            <!-- ★通貨制度（金本位）の**法**をここに置く（作者指示2026-08-11＝金本位は経済の画面で扱いたい）。
                 旧「加入する」ボタンは撤去済み＝あれは同じ Policy.GoldStandardTarget を叩く二重実装で、しかも
                 「加入する」と書きながら実際は意思を立てるだけだった（議会の政治ゲート→法→財政の信用ゲートを経て兌換が始まる）。
                 ここに置くのは法律タブと同じ段ボタン（LawRowVM）＝押せば議会を通る。法律タブからは外してある（同じ法を2箇所に出さない）。 -->
            <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Bottom">
                <ItemsControl ItemsSource="{Binding EconLaws}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="72,*" Margin="0,2" IsVisible="{Binding Visible}">
                                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <ItemsControl ItemsSource="{Binding Stages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent" Margin="0,0,3,2" ToolTip.Tip="{Binding Hint}" ToolTip.ShowDelay="200">
                                                    <Button Classes="lawstage" Classes.current="{Binding IsCurrent}" Classes.target="{Binding IsTarget}"
                                                            IsEnabled="{Binding Enabled}"
                                                            Content="{Binding Label}" Command="{Binding Row.SelectCommand}" CommandParameter="{Binding Index}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Detail}" Classes="range" Classes.amend="{Binding Amendable}" TextWrapping="Wrap"
                                               IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- ★通貨改革（2026-08-13）：発動条件を満たしたときだけ出す（押せないボタンを置かない＝UI最小主義）。
                     新平価を実力に取るか旧平価(1.00)に戻すかがプレイヤーの決断＝ポワンカレ1926 と 英1925 の分岐。 -->
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0" IsVisible="{Binding CurrencyReformVisible}">
                    <TextBlock Text="通貨改革" Foreground="{StaticResource InkSoftBrush}" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"/>
                    <Button Classes="lawstage" Content="{Binding CurrencyReformParityText, StringFormat='新平価 {0}'}" Command="{Binding ReformAtMarketCommand}"/>
                    <Button Classes="lawstage" Content="旧平価 1.00" Command="{Binding ReformAtParCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <!-- アヘン禁令は生産タブへ・借金ボタン/国債表示はヘッダーへ移設（2026-07-21ユーザー指示）・借入はエンジンが r＜1 の月に自動（2026-09-28） -->
        </StackPanel>
    </StackPanel>
</UserControl>
