<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PriceOfBread.App.ViewModels"
             x:Class="PriceOfBread.App.Views.Tabs.DiploTab"
             x:DataType="vm:GameViewModel">
    <!-- Views/Tabs/DiploTab.axaml ＝ 外交タブの本体（列見出しは GameView.axaml のドック側に残る）。 -->
    <UserControl.Resources>
    <!-- 外交タブの国1行。★2026-08-10に**2段組**へ（作者指示）＝左右の段が同じ見た目でなければならないので、
         行の型はここに1つだけ置いて両段が共有する（片方だけ直る事故を構造的に防ぐ）。
         ★2026-08-10（作者裁定）：**元の幅650のまま2段**にする（外交だけドックを1280へ広げるのは撤回＝地図が見えなくなっていた）。
         1段＝(650−1−左右余白36−段間16)/2 ≒ 298px。列は 26（順位）｜*（国名＋バッジ）｜58（アクション）｜30（緊張）。
         58＝侵略/統一戦争ボタン（Button.mini.dense、縦StackPanel＝複数同時表示時は行が縦に伸びる・2026-09-23にWrapPanelから）。緊張は「100%」が入る最小幅。
         余った分は全て国名＝旧レイアウトの MaxWidth=110 より広く、大半の国名が省略なしで出る。
         ⚠この列定義は GameView.axaml の見出し行と**同じ文字列**で二重に書かれている（両方を同時に直すこと）。 -->
    <DataTemplate x:Key="NationRowTemplate" x:DataType="vm:NationCard">
      <Panel>
        <!-- ★ランクの区切り（作者指示2026-08-11）＝同じ一覧に混ぜた見出し行。押せない・順位も緊張も持たない。 -->
        <TextBlock Text="{Binding Header}" IsVisible="{Binding IsHeader}" Foreground="{StaticResource BronzeBrush}" FontWeight="Bold"
                   FontSize="{StaticResource FontTiny}" Margin="2,6,0,2"/>
        <Button Classes="row" IsVisible="{Binding IsRow}" Command="{Binding CenterCmd}" CommandParameter="{Binding PowerName}">
            <Grid ColumnDefinitions="26,*,58,30" Background="{Binding RowBrush}" MinHeight="24">
                <!-- 国家情報のツールチップは各データセルにのみ付ける（アクション列＝緊張ボタン等の上では出さない） -->
                <TextBlock Grid.Column="0" Text="{Binding Order}" Foreground="{StaticResource InkMutedBrush}" FontSize="{StaticResource FontTiny}" VerticalAlignment="Center" Margin="2,0"
                           ToolTip.Tip="{Binding Detail}" ToolTip.ShowDelay="200"/>
                <!-- ★2026-08-01：国名＋帰属バッジ。**折り返さない**＝行高が MinHeight で固定される。
                     ★2026-08-10：StackPanel から Grid（Auto,*,Auto）へ。旧 StackPanel は国名 MaxWidth=110 とバッジの合計が
                     列幅120を超えても**はみ出して隣のボタンに重なっていた**（実写で「ラオス王国［シャムの属国］化」）。
                     国名＝余りを取って省略・バッジ＝内容ぶん（上限66で省略）＝どちらも列の外へ出ない。全文はホバーの詳細にある。
                     ⚠**2026-09-23の実写＝バッジが切れて意味が変わる**（当方で撮って確認した2件）。
                       清1783 の32位「デリー王国」＝**「マラータ同盟…」**（本来「マラータ同盟の属国」89.7px）
                       サルデーニャ1784 の57位「ヴュルテンベルク人…」＝**「プロイセンの…」**（本来「プロイセンの属国」76.8px）
                     前の回の実写（仏1850）では「オヨ帝国の属国」71.4px が**「オヨ帝国の属」**＝末尾の「国」だけが落ち、
                     「の属」という**存在しない語**に見えていた。他も「ライン諸邦の属国」80.5px・「アシャンティの属国」85.9px
                     ＝MaxWidth 66 に収まる宗主名はごく短いものだけ。MaxWidth を上げれば国名の幅を食う（列は298.5px固定）。
                     **決めた形＝バッジ本文は宗主国名だけにし、「属国である」ことは BadgeOtherVassal（#7A6A55）の色が担う。**
                     根拠＝固有名詞は途中で切れても固有名詞のまま（誤読にならない）が、「○○の属国」は末尾が落ちると別の語になる。
                     名前だけなら実在の宗主はほぼ66px以内（マラータ同盟58.5／アシャンティ54.8／ライン諸邦49.4／プロイセン45.6／
                     オヨ帝国40.3／イギリス29.9px）。最長の「サルデーニャ＝ピエモンテ」111.4px だけは切れるが、切れても国名として読める。
                     ⚠**文字列を組むのはこのファイルではない**＝GameViewModel.Refresh.cs（この枠の所有外・行番号は他枠の編集で動くので
                     `powSuz is not null` の枝をgrepで引く）の `badge = $"{powSuz.Name}の属国"` を `badge = powSuz.Name` にする1行。
                     **未実施**（所有外のため1バイトも触っていない）。
                     バッジの全文（「○○の属国」）はホバーの詳細（Detail の「関係:」行）に元から残っている。 -->
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" Background="Transparent"
                      ToolTip.Tip="{Binding Detail}" ToolTip.ShowDelay="200">
                    <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource InkBrush}" FontSize="{StaticResource FontSmall}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                    <Border Grid.Column="2" Background="{Binding BadgeBrush}" CornerRadius="2" Padding="4,0" Height="16" IsVisible="{Binding HasBadge}" VerticalAlignment="Center" Margin="0,1">
                        <TextBlock Text="{Binding Badge}" Foreground="#FFF6E8" FontSize="{StaticResource FontTiny}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="66"/>
                    </Border>
                </Grid>
                <!-- ★2026-09-23（作者指示「侵略ボタンと緊張の隙間が大きい。侵略ボタンを右に寄せる」）＝右寄せ。
                     列幅58は変えない（GameView.axaml の見出し行＝`ColumnDefinitions="26,*,58,30"` を grep で引いて同一文字列に保つ。Auto にすると見出しとずれる）。
                     左へはみ出さない根拠。⚠**字幅の前提を実測へ差し替えた（2026-09-23）**＝旧コメントの
                     「Yu Gothic UI は全角1文字ちょうど 1.000em」は**誤り**。実測は 漢字 1.000em・**仮名 0.830em**（比例幅）・半角 0.5545em。
                     Button.mini は FontSize 11・Padding 4,2（.dense）・BorderThickness 1：
                       侵略　　＝漢字2×11＝22 ＋Padding(4+4)＋枠(1+1)＝32 ＋右マージン4＝36 → 原点 58−36＝22 だけ右へ寄る
                       統一戦争＝漢字4×11＝44 ＋8＋2＝54 ＋右マージン4＝58＝列幅ちょうど → 原点 58−58＝0＝左端が国名列に接する
                     ⚠**この2つはどちらも全て漢字**なので、誤った前提でも数だけは同じになっていた（偶然合っていた）。
                     仮名を含む文言をここへ置くときは 0.830em で数え直すこと。
                     どちらも desired ≤ 58 ＝原点が負になる枝が無い（＝国名側へ食い込まない）ので MaxWidth は要らない。
                     ★2026-09-23：**実画面で確かめた**（サルデーニャ＝ピエモンテ・1784・統一戦争が出る盤面）。
                     「統一戦争」ボタンの枠の画素は x=1496..1549（幅54px）＝アクション列 1495.5..1553.5 の内側で、
                     国名列（..1495.5）へ**1画素も食い込んでいない**。1行に「統一戦争」と「侵略」が両方出る行（56位トスカーナ）も
                     縦に積まれて2つとも右端で揃い、国名にも緊張にも重なっていない。
                     ★WrapPanel から**縦 StackPanel** へ：2つ同時に出る行（統一戦争の標的は弱小＝ShowInvade も真）で
                     WrapPanel は折り返すが、折り返した行は左詰めのまま＝侵略だけ元の位置に取り残されていた。
                     縦積みなら各段を個別に右寄せできる。58px には2つ並ばない（32+32=64＞58）ので WrapPanel は
                     元から常に1つずつ折り返していた＝この入れ替えで横に並ぶ組み合わせが消えることは無い。 -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,2">
                    <Border IsVisible="{Binding ShowUnif}" HorizontalAlignment="Right" Background="Transparent" ToolTip.Tip="{Binding UnifTip}" ToolTip.ShowDelay="80" Margin="0,0,4,2">
                        <Button Classes="mini dense" Content="統一戦争" IsEnabled="{Binding CanUnif}"
                                Command="{Binding UnifCmd}" CommandParameter="{Binding PowerName}"/>
                    </Border>
                    <!-- 緊張の増加/減少ボタンは廃止（1934拡張#106）：緊張が高まると自動でポップアップが出て、そこで増減を選ぶ（AIも同じ挙動） -->
                    <!-- 防衛同盟ボタンは廃止（2026-08-01）：同盟は Diplomacy の「共通の敵を恐れる二国が手を結ぶ」経路で**プレイヤーも含めて自動**に成立する。
                         手動ボタンはそれと二重で、プレイヤーだけが同盟枠を先取りできる非対称を生んでいた（禁輸ボタンと同じ型）。 -->
                    <!-- 禁輸ボタンは廃止（禁制品doc C1・2026-07-30）：禁輸は挑発に同梱＋戦時は強制・終戦で自動解除＝50カ国の手動管理を畳んだ -->
                    <!-- 侵略＝弱小への唯一の動詞（作者裁定2026-08-23＝旧「植民地化」と1本化）。屈服なら属国化/併合・拒めば開戦 -->
                    <Border IsVisible="{Binding ShowInvade}" HorizontalAlignment="Right" Background="Transparent" ToolTip.Tip="{Binding InvadeTip}" ToolTip.ShowDelay="80" Margin="0,0,4,2">
                        <Button Classes="mini dense" Content="{Binding InvadeLabel}" IsEnabled="{Binding CanInvade}"
                                Command="{Binding InvadeCmd}" CommandParameter="{Binding PowerName}"/>
                    </Border>
                    <!-- 通商条約ボタンは廃止（2026-09-07作者指示）：締結は Diplomacy.TradeTreaties の四半期の掃引で**プレイヤーも含めて自動**
                         （同盟・禁輸の自動化と同じ型＝自動化できるレバーは置かない）。関税目標の状態は経済タブが映す。 -->
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding Tension}" Foreground="{Binding TensionBrush}" FontWeight="Bold" FontSize="{StaticResource FontTiny}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,3,2,3"
                           ToolTip.Tip="{Binding Detail}" ToolTip.ShowDelay="200"/>
            </Grid>
        </Button>
      </Panel>
    </DataTemplate>
    </UserControl.Resources>
    <!-- ============ 外交：行ホバー＝その国の詳細（スコア内訳・緊張要因・関係）／行クリック＝地図をその国へ ============
         ★2026-08-10（作者指示）：**2段組**。左段＝順位の上位半分・右段＝残り（列で読む）。
         行の型は UserControl.Resources の NationRowTemplate を両段で共有。
         61カ国×2段（約800px）。縦の送りは GameView.axaml の DockScroll が持つ＝
         **ここに ScrollViewer を足さないこと**（列見出しはスクロールの外に固定してある＝行が増減しても見出しは動かない）。 -->
    <Grid ColumnDefinitions="*,16,*">
        <ItemsControl Grid.Column="0" VerticalAlignment="Top" ItemsSource="{Binding NationsLeft}" ItemTemplate="{StaticResource NationRowTemplate}"/>
        <ItemsControl Grid.Column="2" VerticalAlignment="Top" ItemsSource="{Binding NationsRight}" ItemTemplate="{StaticResource NationRowTemplate}"/>
    </Grid>
</UserControl>
