<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PriceOfBread.App.ViewModels"
             x:Class="PriceOfBread.App.Views.Tabs.TradeTab"
             x:DataType="vm:GameViewModel">
    <!-- Views/Tabs/TradeTab.axaml ＝ 貿易タブの本体。 -->
    <!-- ============ 貿易（2026-07-24・Eキー）：輸出入一覧＋輸送サマリ＋条約港（外国経済の可視化doc §3-6/§3-7） ============ -->
    <StackPanel Spacing="4">
        <!-- ★2026-08-11の再構成（作者指示）：**輸送が先・貿易一覧が最下部**（一覧は品目数で伸び縮みするので、
             伸びる物を下へ置く＝上の行が動かない）。総額は財政タブの合計と同じ作法で**列の下端に揃える**。 -->
        <TextBlock Text="輸送" Classes="section"/>
        <ItemsControl ItemsSource="{Binding TransportRows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TransportRow">
                    <Grid ColumnDefinitions="220,*">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="dim" FontSize="{StaticResource FontSmall}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource InkBrush}" FontSize="{StaticResource FontSmall}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- ★2026-08-15作者フィードバック(10)：関税行（財政タブと重複）・開放度行は撤去。収支は最下部の大型表示へ（財政タブと同レイアウト） -->
        <!-- ★条約港（2026-08-04）：開かされた港＝関税自主権の喪失。0港なら行ごと非表示 -->
        <TextBlock Text="{Binding TreatyPortLine}" Foreground="{StaticResource RustBrush}" FontSize="{StaticResource FontSmall}" IsVisible="{Binding HasTreatyPorts}"/>
        <Border Height="1" Background="{StaticResource SandBrush}" Margin="0,4"/>

        <!-- 貿易一覧＝左が輸入・右が輸出（財政タブの収入/支出と同じ作法）。総額は各列の**下端**に置く。 -->
        <Grid ColumnDefinitions="*,16,*">
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Spacing="1">
                    <TextBlock Text="輸入(金額の降順)" Classes="section"/>
                    <Grid ColumnDefinitions="*,82,52,62,72">
                        <TextBlock Grid.Column="0" Text="財" Classes="section" FontSize="{StaticResource FontSmall}"/>
                        <TextBlock Grid.Column="1" Text="金額/月" Classes="section" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="数量/月" Classes="section" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="依存度" Classes="section" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="輸入元" Classes="section" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ImportRows}" IsVisible="{Binding HasImportRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TradeRow">
                                <Grid ColumnDefinitions="*,82,52,62,72" Margin="0,1">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource InkBrush}" FontSize="{StaticResource FontSmall}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource InkBrush}" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Qty}" Foreground="{StaticResource InkMutedBrush}" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Extra}" Foreground="{StaticResource BlueBrush}" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Partner}" Foreground="{StaticResource InkMutedBrush}" FontSize="{StaticResource FontSmall}" TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <!-- ★2026-08-15(10)：総額は財政タブの合計と同じ格（FontSize 13・下端固定） -->
                <Grid Grid.Row="2" ColumnDefinitions="96,*" Margin="0,4,0,0">
                    <TextBlock Grid.Column="0" Text="輸入総額" Foreground="{StaticResource InkMutedBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding TradeImportTotal}" Foreground="{StaticResource InkBrush}" FontSize="{StaticResource FontBody}" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
            </Grid>
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Spacing="1">
                    <TextBlock Text="輸出(金額の降順)" Classes="section"/>
                    <Grid ColumnDefinitions="*,82,52,62,72">
                        <TextBlock Grid.Column="0" Text="財" Classes="section" FontSize="{StaticResource FontSmall}"/>
                        <TextBlock Grid.Column="1" Text="金額/月" Classes="section" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="数量/月" Classes="section" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="世界シェア" Classes="section" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="輸出先" Classes="section" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ExportRows}" IsVisible="{Binding HasExportRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TradeRow">
                                <Grid ColumnDefinitions="*,82,52,62,72" Margin="0,1">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource InkBrush}" FontSize="{StaticResource FontSmall}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource InkBrush}" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Qty}" Foreground="{StaticResource InkMutedBrush}" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Extra}" Foreground="{StaticResource BlueBrush}" FontSize="{StaticResource FontSmall}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Partner}" Foreground="{StaticResource InkMutedBrush}" FontSize="{StaticResource FontSmall}" TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Grid Grid.Row="2" ColumnDefinitions="96,*" Margin="0,4,0,0">
                    <TextBlock Grid.Column="0" Text="輸出総額" Foreground="{StaticResource InkMutedBrush}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Column="1" Text="{Binding TradeExportTotal}" Foreground="{StaticResource InkBrush}" FontSize="{StaticResource FontBody}" FontWeight="Bold" TextAlignment="Right"/>
                </Grid>
            </Grid>
        </Grid>
        <!-- ★2026-08-15(10)：収支＝総額の下・右列の下端に大きく（財政タブの収支と同じ作法） -->
        <Grid ColumnDefinitions="*,16,*">
            <StackPanel Grid.Column="2" Spacing="4">
                <Border Height="1" Background="{StaticResource SandBrush}" Margin="0,4,0,4"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="収支" Foreground="{StaticResource BronzeBrush}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding TradeBalance}" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="22" TextAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
