<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PriceOfBread.App.ViewModels"
             xmlns:ctl="using:PriceOfBread.App.Controls"
             x:Class="PriceOfBread.App.Views.Pages.FiscalMoneyPage"
             x:DataType="vm:GameViewModel">
    <!-- Views/Pages/FiscalMoneyPage.axaml ＝ 財政と貨幣のページ（(501) 段3）。欄の並べは .axaml.cs の PageTable（設計 §3-3）。
         行と列は本体の目録（SimCore/Display/FiscalTables）が渡す＝財政の項・段・金融の行を足すときにこの XAML は直さない。
         ページの外側は流れない（長い一覧は表の中だけで流れ、見出しの行は止まる）。 -->
    <ctl:PageGrid x:Name="PageBody">
        <ctl:Section Key="spend" Title="{Binding SpendTitle}" Scrolls="False">
            <ctl:TableView Snapshot="{Binding SpendTable}" InnerScroll="True"/>
        </ctl:Section>
        <ctl:Section Key="income" Title="{Binding IncomeTitle}" Scrolls="False">
            <ctl:TableView Snapshot="{Binding IncomeTable}" InnerScroll="True"/>
        </ctl:Section>
        <ctl:Section Key="finance" Title="金融" Scrolls="False">
            <ctl:TableView Snapshot="{Binding FinanceTable}" InnerScroll="True"/>
        </ctl:Section>
        <ctl:Section Key="ledger" Title="{Binding LedgerTitle}" Scrolls="False">
            <ctl:TableView Snapshot="{Binding LedgerTable}" InnerScroll="True"/>
        </ctl:Section>
        <ctl:Section Key="debt" Title="国債と外資信用">
            <StackPanel Spacing="4">
                <ctl:TableView Snapshot="{Binding DebtTable}"/>
                <TextBlock Text="国庫" Classes="range" Margin="0,6,0,0"/>
                <ctl:LineChart x:Name="TreasuryChart" Values="{Binding TreasuryValues}" Height="56" Stroke="{StaticResource BlueBrush}"/>
                <TextBlock Text="国債" Classes="range"/>
                <ctl:LineChart x:Name="DebtChart" Values="{Binding GovDebtValues}" Height="56" Stroke="{StaticResource RustBrush}"/>
            </StackPanel>
        </ctl:Section>
        <ctl:Section Key="tech" Title="技術水準">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding TechLevelText}" Classes="range"/>
                <ctl:LineChart x:Name="TechChart" Values="{Binding TechValues}" Height="56" Stroke="{StaticResource BronzeBrush}"/>
            </StackPanel>
        </ctl:Section>
    </ctl:PageGrid>
</UserControl>
