<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PriceOfBread.App.ViewModels"
             xmlns:ctl="using:PriceOfBread.App.Controls"
             x:Class="PriceOfBread.App.Views.Pages.PopulationPage"
             x:DataType="vm:GameViewModel">
    <!-- Views/Pages/PopulationPage.axaml ＝ 人口のページ（(501) 段3）。欄の並べは .axaml.cs の PageTable（設計 §3-3）。
         行と列は本体の目録（SimCore/Display/PopTables）が渡す＝階級の表の列を足すときにこの XAML は直さない（見出しと行の列の定義は共通の表が 1 つの定義から作る）。 -->
    <ctl:PageGrid x:Name="PageBody" Margin="4">
        <ctl:Section Key="classes" Title="階級" Scrolls="False">
            <ctl:TableView Snapshot="{Binding ClassTable}" InnerScroll="True" ScrollX="True"/>
        </ctl:Section>
        <ctl:Section Key="regions" Title="州の表" Scrolls="False">
            <ctl:TableView Snapshot="{Binding RegionTable}" InnerScroll="True" ScrollX="True"/>
        </ctl:Section>
        <ctl:Section Key="age" Title="年齢の層">
            <StackPanel Spacing="4">
                <!-- 児童の就業率は図の上（図の下に浮かせない）・字は本文の小（B36） -->
                <TextBlock Text="{Binding CropLine}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource InkSoftBrush}" IsVisible="{Binding CropLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <TextBlock Text="{Binding ChildLaborLine}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource InkSoftBrush}" IsVisible="{Binding ChildLaborLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <ctl:AgeBars Data="{Binding AgePyramid}"/>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Text="粗出生率" Classes="range"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BirthRateText}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Grid.Row="1" Text="粗死亡率" Classes="range"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeathRateText}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Grid.Row="2" Text="合計出生率" Classes="range"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FertilityText}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource InkBrush}"/>
                </Grid>
            </StackPanel>
        </ctl:Section>
        <ctl:Section Key="religion" Title="宗教" Scrolls="False">
            <ctl:TableView Snapshot="{Binding ReligionTable}" InnerScroll="True"/>
        </ctl:Section>
        <ctl:Section Key="culture" Title="文化" Scrolls="False">
            <ctl:TableView Snapshot="{Binding CultureTable}" InnerScroll="True"/>
        </ctl:Section>
    </ctl:PageGrid>
</UserControl>
