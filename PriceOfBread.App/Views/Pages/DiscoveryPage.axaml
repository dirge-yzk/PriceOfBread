<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PriceOfBread.App.ViewModels"
             xmlns:ctl="using:PriceOfBread.App.Controls"
             x:Class="PriceOfBread.App.Views.Pages.DiscoveryPage"
             x:DataType="vm:GameViewModel">
    <!-- Views/Pages/DiscoveryPage.axaml ＝ 発見のページ（(501) 段3）。欄の並べは .axaml.cs の PageTable（設計 §3-3）。
         行と列は本体の目録（SimCore/Display/DiscoveryTables）が渡す＝発見の行（Catalog.Discoveries）が増えてもこの XAML は直さない。割合は出す・閾値は出さない（作者裁定 2026-09-23）。 -->
    <ctl:PageGrid x:Name="PageBody" Margin="4">
        <ctl:Section Key="discovery" Title="技術" Scrolls="False">
            <Grid ColumnDefinitions="*,8,*">
                <ctl:TableView x:Name="TechLeft" Snapshot="{Binding DiscoveryTableLeft}" InnerScroll="True" ScrollX="True"/>
                <ctl:TableView Grid.Column="2" x:Name="TechRight" Snapshot="{Binding DiscoveryTableRight}" InnerScroll="True" ScrollX="True"/>
            </Grid>
        </ctl:Section>
        <ctl:Section Key="social" Title="政府と思想" Scrolls="False">
            <ctl:TableView x:Name="SocialList" Snapshot="{Binding SocialDiscoveryTable}" InnerScroll="True"/>
        </ctl:Section>
        <ctl:Section Key="sites" Title="産地" Scrolls="False">
            <ctl:TableView x:Name="SiteList" Snapshot="{Binding SiteTable}" InnerScroll="True" ScrollX="True"/>
        </ctl:Section>
    </ctl:PageGrid>
</UserControl>
