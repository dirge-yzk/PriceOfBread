<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PriceOfBread.App.ViewModels"
             xmlns:ctl="using:PriceOfBread.App.Controls"
             x:Class="PriceOfBread.App.Views.Pages.MarketPage"
             x:DataType="vm:GameViewModel">
    <!-- Views/Pages/MarketPage.axaml ＝ 財の価格のページ（設計 §3-3）。財の値段の表だけ（輸出と輸入は貿易のページ・作者指示 2026-11-22）。
         欄の並べは PageGrid が決める（並べの表は MarketPage.axaml.cs）。表の行と列は本体の目録（SimCore/Display の MarketTables）が名乗る。 -->
    <Grid Margin="4">
        <ctl:PageGrid x:Name="MarketGrid">
        <ctl:Section x:Name="PricesSection" Key="prices" Title="財の値段">
            <ctl:Section.Body>
                <ctl:TableView x:Name="PricesTable" Snapshot="{Binding PriceTable}" InnerScroll="True"/>
            </ctl:Section.Body>
        </ctl:Section>


        </ctl:PageGrid>
    </Grid>
</UserControl>
