+        var g = r.Producers.First(p => p.IsRgo && p.GoodId == Catalog.WheatId && !p.Bankrupt);
+        f.Scale = 10;
+        double Mc(Producer p) => EconomyStep.MineralSelfCost(p, r, c, w) + EconomyStep.InputCostPerUnit(p, r, r, c);
+        r.Markets[g.GoodId].Price = Mc(g) * 1.06;   // 小麦を先に置く（パンの変動費は小麦の値段を読む）
+        r.Markets[f.GoodId].Price = Mc(f) * 1.06;
+        EconomyStep.Run(r, c, 1.0, w.Bank, w);
+        Assert.True(f.Capacity > 0 && g.Capacity > 0, "前提が崩れた：能力が立っていない");
+        Assert.Equal(1.0, f.DesiredOutput / f.Capacity, 9);                        // 採算 0.06 ≥ FactorySupplySlope 0.05＝全稼働
+        Assert.Equal(0.06 / c.SupplySlope, g.DesiredOutput / g.Capacity, 9);       // 産地は (価格−変動費)÷(変動費×SupplySlope)
+        Assert.True(c.FactorySupplySlope < c.SupplySlope);
+    }
+
+    /// <summary>★(215) 橋：私的な建設は工業化度も積む（main の規則〔限界収益×(1+技術の梃子)−資本コスト〕＝IndustrializationSpeed）。速さ0 の双子と比べる＝差が橋そのもの。
+    /// 助走の間は積まない。工場の設備の投資とは別の指数で、設備の投資の額を工業化度に写さない（工業化度の増分は束の数×IndPerConstruction の一桁＝設備の増分より桁が小さい）。</summary>
+    [Fact]
+    public void 段2_私的な建設は工業化度も積み助走の間は積まない()
+    {
+        double Ind(double speed, bool warm, double earned = 1e9)
+        {
+            var a = Fr200(); var w = a.World; var c = w.Coef; c.IndustrializationSpeed = speed; var r = w.Regions[0];
+            r.Pops[r.InvestorPopIndex].SetSavings(1e9); r.Pops[r.InvestorPopIndex].Earned = earned;
+            foreach (var f in r.Producers.Where(EconomyStep.IsFactory)) { f.SmoothedMargin = 2.0; f.LastInputFill = 1; f.Output = Math.Max(f.Output, 10); }   // 設備の投資の計画が大きい盤面（池の充足が1 を割る）
+            w.WarmupFrozen = warm;
+            double i0 = r.Industrialization;
+            EconomyStep.Run(r, c, 2.0, w.Bank, w);   // 技術の梃子（productivityMultiplier 2.0）
+            return r.Industrialization - i0;
+        }
+        double s0 = new Coefficients().IndustrializationSpeed;
+        Assert.True(Ind(s0, false) > Ind(0, false) + 1e-9, "私的な建設が工業化度を積まない（橋が切れている）");
+        Assert.Equal(Ind(0, true), Ind(s0, true), 12);   // 助走の間は積まない
+        // 工業化度の伸びは設備の投資の池の充足に縛られない（main の投資枠は拘束しなかった＝設備の資金不足で工業化度を止めない）：池がほぼ空の月でも満額の半分以上積む
+        Assert.True(Ind(s0, false, earned: 1) > 0.5 * Ind(s0, false), "工業化度の伸びが設備の投資の池の充足に縛られている");
+    }
+
+    /// <summary>★(215) 投資枠＝IndInvestIncomeFrac×前の月の所得（貯蓄のストックの項は外した＝初期の巨大な貯蓄で開幕の建設の急増を起こさない）・上限は手元（貯蓄＋前の月の所得）。貯蓄が尽きた投資家（金利生活者のポンプで米 1883・日 1903・英 1923 に0 近く）でも
+    /// 所得の項で投資枠が立つ（旧の上限＝貯蓄だけでは所得の項が効かなかった）・手元を超えて払わない・NaN の所得は0・接収の萎縮は投資枠を縮める。</summary>
+    [Fact]
+    public void 段2_投資枠は貯蓄が尽きても前の月の所得の項で立ち手元を超えない()
+    {
+        var a = Fr200(); var w = a.World; var c = w.Coef; var r = w.Regions[0];
+        var inv = r.Pops[r.InvestorPopIndex];
+        inv.SetSavings(0);
+        double e = 1000;
+        Assert.Equal(c.IndInvestIncomeFrac * e, EconomyStep.InvestBudget(r, c, e, false), 9);   // 貯蓄0 でも所得の項が立つ
+        inv.SetSavings(10);
+        Assert.Equal(c.IndInvestIncomeFrac * e, EconomyStep.InvestBudget(r, c, e, false), 9);   // 貯蓄の項は無い＝貯蓄が10 でも同じ
+        inv.SetSavings(1e9);
+        Assert.Equal(c.IndInvestIncomeFrac * e, EconomyStep.InvestBudget(r, c, e, false), 9);   // 巨大な貯蓄でも投資枠は動かない（開幕の建設の急増を起こさない）
+        inv.SetSavings(10);
+        Assert.Equal(0.0, EconomyStep.InvestBudget(r, c, double.NaN, false), 9);   // 否定形＝NaN の所得は0
+        c.IndInvestIncomeFrac = 5.0;   // 所得の5倍を望んでも手元（貯蓄＋前の月の所得）まで
+        Assert.Equal(10 + e, EconomyStep.InvestBudget(r, c, e, false), 9);
+        c.IndInvestIncomeFrac = 0.4;
+        r.SeizureChill = 0.5;
+        Assert.Equal(0.5 * EconomyStep.InvestBudget(r, c, e, false), EconomyStep.InvestBudget(r, c, e, true), 9);
+    }
 }
