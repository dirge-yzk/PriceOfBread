+    /// <summary>★(215) 戦場の資本破壊は工場の設備（Scale）にも国営の持分（BuiltScale）にも工業化度と同じ率で効く（劣勢の側の国土が戦場になる＝WarZoneCapitalDamage）。
+    /// (200) は工業化度の廃止で工場の設備を戦災から外していた。国営の持分も同じ率＝国営の割合は変わらない。</summary>
+    [Fact]
+    public void 戦場の資本破壊は工場の設備と国営の持分にも工業化度と同じ率で効く()
+    {
+        var (sim, _, fr, _) = OneFront(new Coefficients().WarCivilianToll);
+        var facs = new List<(Producer P, double K, double B)>();
+        foreach (var r in fr.Regions)
+            foreach (var p in r.Producers)
+                if (r.State == RegionState.Active && EconomyStep.IsFactory(p) && p.Scale > 1e-9) { p.BuiltScale = 0.25 * p.Scale; facs.Add((p, p.Scale, p.BuiltScale)); }
+        Assert.True(facs.Count > 0, "前提が崩れた：設備のある工場がない");
+        var ind0 = fr.Regions.Where(r => r.State == RegionState.Active).ToDictionary(r => r, r => r.Industrialization);
+        Assert.True(ind0.Values.Any(v => v > 1e-9), "前提が崩れた：工業化度が0");
+        sim.Diplomacy.Step(sim.Coef, sim.Rng, month: 60);
+        int checkedN = 0;
+        foreach (var (p, k, b) in facs)
+        {
+            var reg = fr.Regions.First(r => r.Producers.Contains(p));
+            if (!(ind0[reg] > 1e-9)) continue;
+            double wear = reg.Industrialization / ind0[reg];
+            Assert.True(wear < 1.0 - 1e-12, $"前提が崩れた：戦場の摩耗が走っていない（工業化度の比 {wear:G6}）");
+            Assert.Equal(k * wear, p.Scale, 9);
+            Assert.Equal(b * wear, p.BuiltScale, 9);
+            checkedN++;
+        }
+        Assert.True(checkedN > 0);
+    }
 }
