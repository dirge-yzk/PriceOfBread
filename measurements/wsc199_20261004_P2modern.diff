+    /// <summary>★(199) 徴兵法の立場（PolicyPreferences の選好）＝旧支配層が賛成・大衆が反対・**近代エリートは平時は反対し、総動員中（World.Mobilized）は反対しない**
+    /// （00一覧 §0-A の 0d・0e の徴兵法の門の支持の構成・(197) の作者への確認②の推奨・推奨で進めた＝作者の承認は未確認）。
+    /// (a) 選好の式（3勢力・上げる向きと下げる向き）・治安維持力の近代エリートは0のまま（同じ case から分けた）
+    /// (b) 呼び手＝純支持（NetSupport＝法の門 GateInfo と施行 MandateGate が読む1本）：下げる一歩の純支持は、平時が総動員中より
+    ///     「近代エリートの政治力×街頭の割合＋議会の自由党の議席×重み」（SupportBreakdown のその2行）だけ大きく、上げる一歩は同じだけ小さい＝門の代価も平時の下げが安い。
+    /// ⚠突然変異「近代エリートは0（旧）」「総動員中も反対する（腕 P）」「交戦中で読む（総動員でなく）」「治安維持力の近代エリートも反対」「近代エリートは賛成」で赤。</summary>
+    [Fact]
+    public void 徴兵法の立場は近代エリートも平時は反対し総動員中は反対しない()
+    {
+        var w = France155().World;
+        var cs = PolicyAxis.ConscriptionLaw;
+        Assert.False(w.AtWarNow, "前提が崩れた：仏が交戦中");
+        // (a) 選好の式
+        w.Mobilized = false;
+        var up = PolicyPreferences.Stance(w, cs, true);
+        Assert.Equal(1.0, up.Trad, 12); Assert.Equal(-1.0, up.Modern, 12); Assert.Equal(-1.0, up.Mass, 12);
+        Assert.Equal(1.0, PolicyPreferences.Stance(w, cs, false).Modern, 12);   // 下げる向き＝近代エリートが押す
+        Assert.Equal(0.0, PolicyPreferences.Stance(w, PolicyAxis.Coercion, true).Modern, 12);   // 治安維持力は旧のまま（秩序で財産を守る側は中立）
+        // (b) 純支持（平時）
+        Assert.True(PolicyPreferences.Build(w).Power[1] > 1e-6, "前提が崩れた：近代エリートの政治力が0");
+        double peaceDn = PolicyPreferences.NetSupport(w, cs, false), peaceUp = PolicyPreferences.NetSupport(w, cs, true);
+        double modernRows = 0;
+        foreach (var (who, wt) in PolicyPreferences.SupportBreakdown(w, cs, false)) if (who is "近代エリート" or "議会・自由党") modernRows += wt;
+        Assert.True(modernRows > 1e-6, $"前提が崩れた：近代エリートの行が無い（{modernRows}）");
+        var gPeace = Government.GateInfo(w, cs, false, (int)w.ConscriptionLaw - 1);
+        // 総動員中
+        w.Mobilized = true;
+        var mob = PolicyPreferences.Stance(w, cs, true);
+        Assert.Equal(0.0, mob.Modern, 12); Assert.Equal(1.0, mob.Trad, 12); Assert.Equal(-1.0, mob.Mass, 12);
+        double mobDn = PolicyPreferences.NetSupport(w, cs, false), mobUp = PolicyPreferences.NetSupport(w, cs, true);
+        Assert.Equal(modernRows, peaceDn - mobDn, 9);    // 効いた量そのもの＝近代エリートの行の分だけ下げが押される
+        Assert.Equal(-modernRows, peaceUp - mobUp, 9);   // 上げは同じだけ押し戻される
+        var gMob = Government.GateInfo(w, cs, false, (int)w.ConscriptionLaw - 1);
+        Assert.True(mobDn < 0 && gPeace.Cost < gMob.Cost, $"平時の下げの代価 {gPeace.Cost} が総動員中 {gMob.Cost} より安くない（純支持 {peaceDn}／{mobDn}）");
+    }
