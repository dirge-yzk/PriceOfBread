+    /// <summary>★(211) 月初の予算の支出反射（使える歳入＝潤沢線）は**前の月の兵士給与**を数える＝AI の減税（RelieveOpulence）と同じ線（R3安定形＝給与は両方の反射の線に入る）。
+    /// 旧（(155)〜(207)）＝月初の予算が兵士給与の請求書を0にしてから軍事費の器と行政の予算が潤沢線を読んだ＝支出反射の線だけ給与を0で数えた（分子と分母の非対称）。
+    /// 盤面＝静かな英の双子（同じ国庫・同じ直近の歳入と請求・1件の額が取り崩しより小さい＝潤沢線が兵士給与で動く盤面）で、月の頭の兵士給与だけを変えて1か月＝
+    /// 給与の大きい双子は潤沢線が高い＝支出反射の上乗せが小さい＝行政の予算（州の和）が小さい。⚠突然変異「給与を0にしてから読む（旧の順）」で双子の行政の予算が等しくなり赤。</summary>
+    [Fact]
+    public void 月初の予算の支出反射は前の月の兵士給与を潤沢線に数える()
+    {
+        double Arm(double soldierPayShare)
+        {
+            var sim = new Simulation(NationConfig.Britain().ToScenario(41), new NullAgent());
+            sim.Run(1);
+            var w = sim.World;
+            double r = w.LastRevenue;
+            Assert.True(r > 0, "前提が崩れた：直近の歳入が0");
+            w.LastSoldierPay = soldierPayShare * r;
+            w.Coef.BorrowFractionOfGdp = 1e-6;   // 1件の額≪取り崩し＝潤沢線≈戦費予備（兵士給与で動く）
+            w.RebaseTreasury(1.5 * UtilityAgent.FiscalBufferOf(w) * UtilityAgent.OpulenceBufferQuarters);   // 給与0の戦費予備の1.5倍＝給与0の双子は潤沢線の上・給与の大きい双子は下（台帳ごと置く）
+            sim.RebaselineInvariants();   // 国庫の代入は流れでない＝保存則の基準線を取り直す
