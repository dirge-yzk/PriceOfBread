+    /// <summary>★(211) 潤沢の減税（AI の RelieveOpulence）は新しい潤沢線を読む＝国庫が潤沢線と戦費予備の間の国にも減税が掛かる（旧の線＝戦費予備なら掛からない）。
+    /// 盤面＝多国の世界を1四半期（両腕は同じ種＝同じ盤面）→全ての国の国庫を戦費予備の0.95倍に置き、AI の1四半期の判断（DecideQuarter）を減税あり／なしで比べる。
+    /// 潤沢線が戦費予備より十分に下の国（国庫÷潤沢線＞1.1）の中に、減税ありの腕で税の目標（5軸の和）が下がる国がある。
+    /// ⚠突然変異「RelieveOpulence が旧の線（戦費予備）を読む」で、国庫が線の下になり1国も下がらず赤。</summary>
+    [Fact]
+    public void 潤沢の減税は戦費予備の下でも新しい潤沢線の上の国庫に掛かる()
+    {
+        static (double[] Taxes, bool[] Above) Arm(bool relief)
+        {
+            var sim = new MultiNationSim(WorldData.Nations(), 1789, _ => new UtilityAgent());
+            sim.StepQuarter();
+            var taxes = new double[sim.Nations.Count]; var above = new bool[sim.Nations.Count];
+            for (int i = 0; i < sim.Nations.Count; i++)
+            {
+                var w = sim.Nations[i].World;
+                double chest = (UtilityAgent.FiscalBufferOf(w) + w.Coef.FiscalBufferSoldierPayWeight * w.Coef.FiscalStressBufferMonths * w.LastSoldierPay) * UtilityAgent.OpulenceBufferQuarters;
+                double t = 0.95 * chest;
+                above[i] = t > 1.1 * UtilityAgent.OpulenceLineOf(w);
+                if (!relief) w.Coef.OpulenceTaxRelief = 0;   // ⚠World.Coef は国ごと別インスタンス
+                w.SetTreasuryRaw(t);
+                new UtilityAgent().DecideQuarter(w);
+                var p = w.Policy;
+                taxes[i] = p.IncomeTaxTarget + p.PollTaxTarget + p.LandTaxTarget + p.ProgressiveTaxTarget + p.TariffTarget;
+            }
+            return (taxes, above);
+        }
+        var off = Arm(relief: false);
+        var on = Arm(relief: true);
+        int above = 0, lowered = 0;
+        for (int i = 0; i < on.Taxes.Length; i++)
+        {
+            if (!on.Above[i]) continue;
+            above++;
+            if (on.Taxes[i] < off.Taxes[i] - 1e-9) lowered++;
+        }
+        Assert.True(above > 0, "潤沢線が戦費予備より十分に下の国が1つも無い＝番人の定義域の外");
+        Assert.True(lowered > 0, $"国庫が潤沢線の上（戦費予備の下）の国 {above} のどれにも減税が掛からない＝減税反射が新しい潤沢線を読んでいない");
+    }
