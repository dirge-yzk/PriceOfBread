+    /// <summary>★(240) 開幕の市場の在庫＝既存の在庫目標の規則（MarketFlow：max(TargetStockFloor, TargetStockBuffer×総需要)×StockpileFactor）を、構築の時点で求められる需要の見積もりに当てる。
+    /// 旧＝CatalogEconomy が全財（役務を含む）・全州に Stock=TargetStock=200 を一律に置いた（開発初期の仮置き・小国で年GDPの1〜2年分）。
+    /// 総需要の見積もり＝その州の全POPの Size×BaseNeed（消費）＋全生産者の初期 Output×投入係数（工場・職人の投入）。構築の時点には前期の需要 LastDemand が無い＝同じ量を物理から見積もる。
+    /// 需要の無い財（BaseNeed=0 の中間財で、使う工場の初期 Output も 0.5 の間）は床 TargetStockFloor。StockpileFactor は開幕は 1（WarScareTension=0）。
+    /// 軍需品の首都の在庫（InitialArsenalMonths）は、この後に max を取って積む。昇格する植民地州は PromoteColonyToRegion が在庫 0 で始める（在庫目標だけ置く）。</summary>
+    private static void SeedOpeningStock(Region region, Coefficients coef)
+    {
+        if (!(coef.StockFromDemand > 0)) return;
+        int n = region.Markets.Length;
+        var need = new double[n];
+        double pop = 0;
+        foreach (var p in region.Pops) pop += p.Size;
+        foreach (var d in Catalog.Goods) if (d.Id >= 0 && d.Id < n) need[d.Id] = pop * d.BaseNeed;
+        foreach (var s in region.Producers)
+            foreach (var inp in s.Inputs)
+                if (inp.GoodId >= 0 && inp.GoodId < n) need[inp.GoodId] += s.Output * inp.QtyPerOutput;
+        for (int gi = 0; gi < n; gi++)
+        {
+            var m = region.Markets[gi];
+            if (m is null) continue;
+            if (coef.StockFromDemand >= 2 && gi == Catalog.WarshipId) continue;   // 診断腕 S_ship：軍艦だけ旧の一律 200 を残す
+            double t = System.Math.Max(coef.TargetStockFloor, coef.TargetStockBuffer * need[gi]);
+            m.Stock = t; m.TargetStock = t;
+        }
+    }
