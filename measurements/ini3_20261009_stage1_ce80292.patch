+
+    /// <summary>
+    /// (224) 段1：英の本国（植民地格の州を除く）の階級の構成は出典の写しの線の内に置く。
+    /// 出典＝Allen (2017) NYUAD WP 0002 Appendix Table 3（Colquhoun を Lindert &amp; Williamson 1982 が改訂・England and Wales 1798）に、
+    /// スコットランド（E&amp;W と同じ形）とアイルランド（農業 0.70【推】）を人口で混ぜた写し（measurements/ini3_20261009_mix.py）。
+    /// 旧（資本家が設定人口の16%・工場労働者41%・本国の人口＝設定 14.0M＋使用人 2.36M）は線の外＝突然変異（旧の値へ戻す）で赤。
+    /// 使用人は設定の総数の内側（欄の和＋使用人＝14,000千人）＝二重に数えない。
+    /// </summary>
+    [Fact]
+    public void 英の本国の階級の構成は出典の写しの線の内にあり使用人は総数の内側にある()
+    {
+        var sim = new MultiNationSim([NationConfig.Britain()], 1789UL, _ => new UtilityAgent());
+        var w = sim.Nations[0].World;
+        var by = new Dictionary<string, double>();
+        double tot = 0;
+        foreach (var r in w.Regions)
+        {
+            if (r.State != RegionState.Active || r.Tier == RegionTier.Colonial) continue;
+            foreach (var p in r.Pops) { by[p.ClassName] = by.GetValueOrDefault(p.ClassName) + p.Size; tot += p.Size; }
+        }
+        double Share(string cls) => by.GetValueOrDefault(cls) / tot;
+        Assert.InRange(tot, 13_860.0, 14_140.0);          // 設定の和＋使用人＝14,000千人の±1%（使用人を総数の外へ上乗せしない）
+        Assert.InRange(Share("資本家"), 0.010, 0.035);    // 雇用して資本を回す人 1.3〜1.7%・Allen の bourgeoisie 3.2%
+        Assert.InRange(Share("農民"), 0.45, 0.60);        // E&W 日付合わせ後 48.7%・アイルランド込み 55.8%
+        Assert.InRange(Share("工場労働者"), 0.20, 0.35);  // E&W 31.0%・混ぜた後 27.3%
+    }
+}
+
+/// <summary>
+/// (224) 機構の番人の盤面用：階級の構成が出典へ直る前（資本家が設定人口の16%・工場労働者41%・専門職 6.9%・使用人を設定の外へ上乗せ）の英。
+/// 貯蓄は階級の1000人あたり定数（Simulation.cs:837-857・段2 で置き換える）なので、人数を史実へ直すと富の順（資本家の厚み）が変わる。
+/// 次の番人は**資本の厚い工業国**を前提に機構（政党の選好・法の通りやすさ・制度の施行）を見る＝構成のデータの値には依らない。
+/// 前提を持ち込む番人にだけ使う（他の英の番人は本物の英のまま）。段2 で貯蓄の式が直ったら本物の英へ戻せるか確かめる。
+/// </summary>
+internal static class LegacyBritain
+{
+    internal static NationConfig Config()
+    {
+        var c = NationConfig.Britain().ShallowClone();
+        c.Nobility = 193; c.Peasant = 3210; c.Worker = 5780; c.Bourgeois = 2248; c.Professional = 963; c.Merchant = 450; c.Artisan = 1156; c.ClergyFrac = 0.4;
+        return c;
+    }
 }
