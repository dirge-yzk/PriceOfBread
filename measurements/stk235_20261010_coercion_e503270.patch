+    /// 旧（絶対の兵数×係数）は3倍になった＝保持力が人口の2乗に比例していた（(233) 保留2）。⚠突然変異＝CoercionForce を絶対の兵数に戻す（÷人口を外す）と赤。</summary>
+    [Fact]
+    public void 回235_治安維持力の目標は人口あたり_人口と兵を同じ比で増やしても変わらない()
+    {
+        static World Build(double k)
+        {
+            var c = NationConfig.France().ShallowClone();   // 共有キャッシュ（WorldData.Nations）を汚染しない
+            c.Nobility *= k; c.Peasant *= k; c.Worker *= k; c.Bourgeois *= k; c.Professional *= k; c.Merchant *= k; c.Artisan *= k;
+            return new Simulation(c.ToScenario(7), new NullAgent()).World;
+        }
+        var w1 = Build(1.0); var w3 = Build(3.0);
+        Assert.True(w1.SoldierSize() > 0);
+        Assert.Equal(3.0, w3.SoldierSize() / w1.SoldierSize(), 6);   // 前提＝播く兵は人口に比例
+        Assert.Equal(3.0, w3.TotalPopulation / w1.TotalPopulation, 6);
+        double f1 = Government.CoercionForce(w1, w1.Coef), f3 = Government.CoercionForce(w3, w3.Coef);
+        Assert.True(f1 > 0);
+        Assert.Equal(f1, f3, 6);   // 強度は同じ
+    }
+
+    /// <summary>★(235) 錨＝「平時の上限の軍（人口×平時の上限の人口比）が完全に装備されたとき、生の値が CoercionMax」。即応度に比例し、兵に比例する。</summary>
+    [Fact]
+    public void 回235_治安維持力の錨は上限の軍が完全に装備されたときCoercionMax()
+    {
+        var w = new Simulation(NationConfig.France().ToScenario(7), new NullAgent()).World;
+        var c = w.Coef;
+        double cap = w.TotalPopulation * Military.PeaceCapShareOfPop(c);
+        w.MilitaryReadiness = 1.0;
+        double full = Government.CoercionForce(w, c);
+        Assert.Equal(c.CoercionMax * w.SoldierSize() / cap, full, 9);   // 兵÷(人口×上限の人口比)×CoercionMax
+        w.MilitaryReadiness = 0.25;
+        Assert.Equal(0.25 * full, Government.CoercionForce(w, c), 9);   // 即応度に比例
+        // 上限ちょうどの軍が完全に装備されたときの生の値は CoercionMax＝ソフト化の後は x/(1+x/最大)＝最大の半分
+        Assert.Equal(c.CoercionMax / 2.0, Government.CoercionTargetFromForce(c.CoercionMax, c), 9);
+    }
