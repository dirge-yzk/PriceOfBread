<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- ★2026-09-25：テストは不変の文化で走らせる（Windows でも Linux でも同じ判定にする）。
         xUnit の Assert.Contains/StartsWith/EndsWith(string) は現在の文化で比べ、日本語の文化は全角と半角（（と(・＋と+ 等）や
         ひらがなとカタカナを同じ字と見なす＝戦闘ログの番人が Windows だけで目隠しされていた（クラウドの Ubuntu で初めて落ちた）。
         1件ずつ Ordinal を書く方式は、これから書くアサートが同じ罠を踏むので設定1行で塞ぐ。Runner（Program.cs）も InvariantCulture。
         ⚠この設定では ja-JP の CultureInfo を作れない＝テストから App の JaNameComparer（GameViewModel.Production.cs）に触ると例外になる。 -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PriceOfBread.SimCore\PriceOfBread.SimCore.csproj" />
    <!-- ★2026-09-20（M5）：生産タブの消費税チェックボックス（ProdDetail.TaxOn）が**エンジンへ届いている**ことを xUnit の射程に入れる。
         ⚠「App はテストから触れない」は長く事実だったが、理由は GameViewModel が Dispatcher.UIThread を踏むことで、
           ProdDetail 単体は ObservableObject＝Avalonia 型は既定値だけ（AppBuilder の初期化は要らない）。
         ⚠新しいテストプロジェクトは作らない（増えるのは参照1つ）。往復の番人は ProductionDiagTests が持つ。 -->
    <ProjectReference Include="..\PriceOfBread.App\PriceOfBread.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ★(419) Runner play の動詞（PlayHarness）の番人：Runner は Exe で参照できない＝PlayHarness.cs だけをソースごとリンクする（SimCore だけに依る・Program.cs には触れない）。
         これで動詞が App の画面と同じ口を叩く／待ちが無いとき何もしない、を xUnit の射程に入れる（PlayHarnessTests）。 -->
    <Compile Include="..\PriceOfBread.Runner\PlayHarness.cs" Link="Linked\PlayHarness.cs" />
    <Compile Include="..\PriceOfBread.Runner\PlayFacts.cs" Link="Linked\PlayFacts.cs" />
  </ItemGroup>

</Project>